---
import Layout from "../layouts/Layout.astro";

const products = [
  {
    name: "Chocolate Cake",
    image: "/products/chocolate.jpg",
    price: "₹500"
  },
  {
    name: "Red Velvet Cake",
    image: "/products/redvelvet.jpg",
    price: "₹700"
  },
  {
    name: "Cup Cake",
    image: "/products/cupcake.jpg",
    price: "₹100"
  }
];
---

<Layout title="Sravs Bakery">

  <!-- HERO SECTION -->
  <section class="hero">

    <div class="hero-content">

      <p class="eyebrow">WELCOME TO SRAVS BAKERY</p>

      <h1>
        Baked with love,
        <span>made for you.</span>
      </h1>

      <p class="hero-text">
        Fresh cakes, delicious pastries and delightful treats
        made with the finest ingredients and lots of love.
      </p>

      <div class="hero-buttons">
        <a href="/menu" class="primary-btn">
          Explore Our Menu
          <span>→</span>
        </a>

        <a href="/contact" class="secondary-btn">
          Contact Us
        </a>
      </div>

    </div>

    <div class="hero-image">
      <img
        src="/products/chocolate.jpg"
        alt="Freshly baked chocolate cake"
      />
    </div>

  </section>


  <!-- PRODUCTS SECTION -->
  <section class="products">

    <div class="section-heading">

      <p class="subtitle">OUR SPECIALITIES</p>

      <h2>Made Fresh, Just for You</h2>

      <div class="heading-line"></div>

      <p>
        Discover some of our favourite freshly baked treats.
      </p>

    </div>


    <div class="product-container">

      {products.map((product) => (

        <div class="card">

          <div class="image-wrapper">

            <img
              src={product.image}
              alt={product.name}
            />

            <span class="fresh-badge">
              Fresh
            </span>

          </div>


          <div class="card-content">

            <h3>{product.name}</h3>

            <div class="card-bottom">

              <p class="price">
                {product.price}
              </p>

              <a href="/menu" class="order-btn">
                Order Now
                <span>→</span>
              </a>

            </div>

          </div>

        </div>

      ))}

    </div>


    <div class="view-menu">
      <a href="/menu">
        View Full Menu
        <span>→</span>
      </a>
    </div>

  </section>


  <!-- ABOUT / QUALITY SECTION -->
  <section class="story">

    <div class="story-image">
      <img
        src="/products/redvelvet.jpg"
        alt="Sravs Bakery cake"
      />
    </div>


    <div class="story-content">

      <p class="subtitle">
        WHY SRAVS BAKERY
      </p>

      <h2>
        A little sweetness
        <span>in every bite.</span>
      </h2>

      <p>
        At Sravs Bakery, we believe that every special moment
        deserves something delicious. From everyday cravings
        to celebrations, our treats are prepared with care
        and served fresh.
      </p>

      <a href="/about" class="story-btn">
        Our Story
        <span>→</span>
      </a>

    </div>

  </section>


  <!-- CTA SECTION -->
  <section class="cta">

    <p class="subtitle">
      HAVE A SWEET CRAVING?
    </p>

    <h2>
      Let us make your day
      <span>a little sweeter.</span>
    </h2>

    <a href="/menu">
      Explore Menu
      <span>→</span>
    </a>

  </section>

</Layout>


<style>

  /* =========================
     GLOBAL
  ========================= */

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fffaf5;
    color: #2b211c;
  }


  /* =========================
     HERO
  ========================= */

  .hero {
    min-height: 650px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;

    max-width: 1200px;
    margin: auto;

    padding: 70px 40px;
    gap: 70px;
  }


  .hero-content {
    max-width: 570px;
  }


  .eyebrow,
  .subtitle {
    margin: 0 0 14px;

    color: #a66a45;

    font-size: 12px;
    font-weight: 700;

    letter-spacing: 3px;
  }


  .hero h1 {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;

    font-size: clamp(48px, 6vw, 76px);

    line-height: 1.05;
    font-weight: 500;

    color: #2b211c;
  }


  .hero h1 span,
  .story h2 span,
  .cta h2 span {
    display: block;
    color: #a66a45;
  }


  .hero-text {
    max-width: 500px;

    margin: 28px 0 35px;

    color: #756a64;

    font-size: 16px;
    line-height: 1.8;
  }


  .hero-buttons {
    display: flex;
    align-items: center;
    gap: 15px;
  }


  .primary-btn,
  .secondary-btn {
    text-decoration: none;

    padding: 14px 22px;

    font-size: 13px;
    font-weight: 600;

    transition: all 0.3s ease;
  }


  .primary-btn {
    background: #2b211c;
    color: white;
  }


  .primary-btn span,
  .secondary-btn span {
    margin-left: 8px;
  }


  .primary-btn:hover {
    background: #a66a45;
  }


  .secondary-btn {
    border: 1px solid #2b211c;
    color: #2b211c;
  }


  .secondary-btn:hover {
    background: #2b211c;
    color: white;
  }


  /* HERO IMAGE */

  .hero-image {
    height: 500px;

    overflow: hidden;

    border-radius: 180px 180px 8px 8px;

    box-shadow: 0 25px 60px rgba(60, 40, 25, 0.15);
  }


  .hero-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.6s ease;
  }


  .hero-image:hover img {
    transform: scale(1.04);
  }


  /* =========================
     PRODUCTS
  ========================= */

  .products {
    padding: 100px 40px;

    background: #fff;
  }


  .section-heading {
    max-width: 650px;

    margin: 0 auto 55px;

    text-align: center;
  }


  .section-heading h2 {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;

    font-size: 42px;
    font-weight: 500;

    color: #2b211c;
  }


  .heading-line {
    width: 55px;
    height: 2px;

    background: #a66a45;

    margin: 18px auto;
  }


  .section-heading > p:last-child {
    margin: 0;

    color: #756a64;

    font-size: 15px;
    line-height: 1.7;
  }


  .product-container {
    max-width: 1150px;

    margin: auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 30px;
  }


  .card {
    overflow: hidden;

    background: #fff;

    border: 1px solid #eee4dc;

    transition: all 0.35s ease;
  }


  .card:hover {
    transform: translateY(-8px);

    box-shadow: 0 20px 45px rgba(60, 40, 25, 0.12);
  }


  .image-wrapper {
    position: relative;

    height: 290px;

    overflow: hidden;
  }


  .card img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.5s ease;
  }


  .card:hover img {
    transform: scale(1.06);
  }


  .fresh-badge {
    position: absolute;

    top: 16px;
    left: 16px;

    padding: 7px 13px;

    background: white;

    border-radius: 20px;

    color: #6d4936;

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 1px;
  }


  .card-content {
    padding: 24px;
  }


  .card-content h3 {
    margin: 0 0 22px;

    font-family: Georgia, "Times New Roman", serif;

    font-size: 23px;
    font-weight: 500;

    color: #2b211c;
  }


  .card-bottom {
    display: flex;

    justify-content: space-between;
    align-items: center;
  }


  .price {
    margin: 0;

    color: #a66a45;

    font-size: 20px;
    font-weight: 700;
  }


  .order-btn {
    text-decoration: none;

    background: #2b211c;
    color: white;

    padding: 11px 15px;

    font-size: 12px;
    font-weight: 600;

    transition: all 0.3s ease;
  }


  .order-btn span {
    margin-left: 6px;
  }


  .order-btn:hover {
    background: #a66a45;
  }


  .view-menu {
    margin-top: 45px;

    text-align: center;
  }


  .view-menu a {
    color: #2b211c;

    text-decoration: none;

    border-bottom: 1px solid #2b211c;

    padding-bottom: 5px;

    font-size: 14px;
    font-weight: 600;
  }


  .view-menu span {
    margin-left: 8px;
  }


  /* =========================
     STORY
  ========================= */

  .story {
    max-width: 1150px;

    margin: auto;

    padding: 100px 40px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    align-items: center;

    gap: 80px;
  }


  .story-image {
    height: 480px;

    overflow: hidden;
  }


  .story-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  .story-content h2 {
    margin: 0 0 25px;

    font-family: Georgia, "Times New Roman", serif;

    font-size: 48px;
    line-height: 1.15;

    font-weight: 500;
  }


  .story-content > p:not(.subtitle) {
    margin: 0 0 30px;

    color: #756a64;

    font-size: 15px;

    line-height: 1.9;
  }


  .story-btn {
    display: inline-block;

    padding: 13px 20px;

    border: 1px solid #2b211c;

    color: #2b211c;

    text-decoration: none;

    font-size: 13px;
    font-weight: 600;

    transition: all 0.3s ease;
  }


  .story-btn span {
    margin-left: 8px;
  }


  .story-btn:hover {
    background: #2b211c;
    color: white;
  }


  /* =========================
     CTA
  ========================= */

  .cta {
    padding: 100px 30px;

    text-align: center;

    background: #f2e6dc;
  }


  .cta h2 {
    max-width: 700px;

    margin: 0 auto 30px;

    font-family: Georgia, "Times New Roman", serif;

    font-size: 48px;
    line-height: 1.15;

    font-weight: 500;
  }


  .cta > a {
    display: inline-block;

    background: #2b211c;
    color: white;

    text-decoration: none;

    padding: 15px 25px;

    font-size: 13px;
    font-weight: 600;

    transition: all 0.3s ease;
  }


  .cta > a span {
    margin-left: 8px;
  }


  .cta > a:hover {
    background: #a66a45;
  }


  /* =========================
     TABLET
  ========================= */

  @media (max-width: 900px) {

    .hero {
      grid-template-columns: 1fr;

      text-align: center;

      gap: 50px;
    }

    .hero-content {
      margin: auto;
    }

    .hero-text {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-image {
      max-width: 600px;
      width: 100%;
      margin: auto;
    }

    .product-container {
      grid-template-columns: repeat(2, 1fr);
    }

    .story {
      grid-template-columns: 1fr;

      gap: 45px;
    }

    .story-content {
      text-align: center;
    }

  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 600px) {

    .hero {
      padding: 55px 20px;
      min-height: auto;
    }


    .hero h1 {
      font-size: 46px;
    }


    .hero-text {
      font-size: 14px;
    }


    .hero-buttons {
      flex-direction: column;
      width: 100%;
    }


    .primary-btn,
    .secondary-btn {
      width: 100%;
      text-align: center;
    }


    .hero-image {
      height: 360px;

      border-radius: 130px 130px 5px 5px;
    }


    .products {
      padding: 70px 20px;
    }


    .section-heading h2 {
      font-size: 34px;
    }


    .product-container {
      grid-template-columns: 1fr;
    }


    .image-wrapper {
      height: 260px;
    }


    .story {
      padding: 70px 20px;
    }


    .story-image {
      height: 350px;
    }


    .story-content h2 {
      font-size: 38px;
    }


    .cta {
      padding: 75px 20px;
    }


    .cta h2 {
      font-size: 38px;
    }

  }

</style>