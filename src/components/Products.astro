---
const products = [
  {
    name: "Chocolate Cake",
    image: "/products/chocolate.jpg",
    price: "₹500"
  },
  {
    name: "Red Velvet Cake",
    image: "/products/redvelvet.jpg",
    price: "₹700"
  },
  {
    name: "Cup Cake",
    image: "/products/cupcake.jpg",
    price: "₹100"
  }
];
---

<section class="products">
  <h2>Our Products</h2>

  <div class="product-container">
    {products.map((product) => (
      <div class="card">
        <img src={product.image} alt={product.name} />

        <h3>{product.name}</h3>
        <p>{product.price}</p>

        <button>Order Now</button>
      </div>
    ))}
  </div>
</section>


<style>
.products {
  padding: 40px;
  text-align: center;
}

.product-container {
  display: flex;
  gap: 25px;
  justify-content: center;
}

.card {
  width: 250px;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px gray;
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

button {
  background: black;
  color: white;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
}
</style>