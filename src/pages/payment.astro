---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Payment - Sravs Bakery">

  <main class="payment-page">

    <div class="payment-container">

      <div class="payment-header">
        <h1>Complete Your Order</h1>
        <p>Enter your delivery details and choose your payment method</p>
      </div>

      <div class="payment-card">

        <!-- DELIVERY DETAILS -->

        <section class="section">

          <h2>Delivery Details</h2>

          <div class="form-group">
            <label for="name">Full Name</label>

            <input
              id="name"
              type="text"
              placeholder="Enter your full name"
              autocomplete="name"
            />
          </div>

          <div class="form-group">
            <label for="phone">Phone Number</label>

            <input
              id="phone"
              type="tel"
              placeholder="10-digit mobile number"
              maxlength="10"
              inputmode="numeric"
              autocomplete="tel"
            />
          </div>

          <div class="form-group">
            <label for="email">Email</label>

            <input
              id="email"
              type="email"
              placeholder="Enter your email"
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="address">House / Flat / Street</label>

            <textarea
              id="address"
              rows="3"
              placeholder="Enter complete delivery address"
              autocomplete="street-address"
            ></textarea>
          </div>

          <div class="form-group">
            <label for="area">Area / Landmark</label>

            <input
              id="area"
              type="text"
              placeholder="Area or nearby landmark"
            />
          </div>

          <div class="two-column">

            <div class="form-group">
              <label for="city">City</label>

              <input
                id="city"
                type="text"
                placeholder="City"
                autocomplete="address-level2"
              />
            </div>

            <div class="form-group">
              <label for="pincode">Pincode</label>

              <input
                id="pincode"
                type="text"
                placeholder="6-digit pincode"
                maxlength="6"
                inputmode="numeric"
                autocomplete="postal-code"
              />
            </div>

          </div>

          <div class="form-group">
            <label for="state">State</label>

            <input
              id="state"
              type="text"
              placeholder="State"
              value="Telangana"
              autocomplete="address-level1"
            />
          </div>

        </section>


        <!-- ORDER SUMMARY -->

        <section class="section order-section">

          <h2>Order Summary</h2>

          <div id="order-items"></div>

          <div class="total-row">

            <span>Total Amount</span>

            <strong id="payment-total">
              ₹0
            </strong>

          </div>

        </section>


        <!-- PAYMENT METHOD -->

        <section class="section">

          <h2>Payment Method</h2>

          <div class="payment-methods">

            <label class="payment-option">

              <input
                type="radio"
                name="payment-method"
                value="cod"
                checked
              />

              <div class="payment-option-content">

                <div class="payment-icon">
                  💵
                </div>

                <div>
                  <strong>Cash on Delivery</strong>

                  <span>
                    Pay when your order is delivered
                  </span>
                </div>

              </div>

            </label>


            <label class="payment-option">

              <input
                type="radio"
                name="payment-method"
                value="online"
              />

              <div class="payment-option-content">

                <div class="payment-icon">
                  💳
                </div>

                <div>
                  <strong>Online Payment</strong>

                  <span>
                    UPI, Card, Net Banking and more
                  </span>

                </div>

              </div>

            </label>

          </div>

        </section>


        <!-- PAYMENT BUTTON -->

        <section class="section payment-action">

          <button
            id="pay-button"
            type="button"
          >
            Place Order - Cash on Delivery
          </button>

          <p
            id="payment-status"
            class="payment-status"
          ></p>

        </section>

      </div>

    </div>

  </main>

</Layout>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>

  /* =====================================
     CART
  ===================================== */

  const cart =
    JSON.parse(
      localStorage.getItem("cart") || "[]"
    );


  let total = 0;


  const orderItems =
    document.getElementById("order-items");


  cart.forEach((item) => {

    const price =
      Number(
        String(item.price)
          .replace(/[^\d.]/g, "")
      ) || 0;


    const quantity =
      Number(item.quantity) || 1;


    const itemTotal =
      price * quantity;


    total += itemTotal;


    if (orderItems) {

      orderItems.innerHTML += `

        <div class="order-item">

          <span>
            ${item.name} × ${quantity}
          </span>

          <strong>
            ₹${itemTotal.toLocaleString("en-IN")}
          </strong>

        </div>

      `;

    }

  });


  const totalElement =
    document.getElementById("payment-total");


  if (totalElement) {

    totalElement.textContent =
      "₹" + total.toLocaleString("en-IN");

  }


  /* =====================================
     ELEMENTS
  ===================================== */

  const payButton =
    document.getElementById("pay-button");


  const status =
    document.getElementById("payment-status");


  const paymentRadios =
    document.querySelectorAll(
      'input[name="payment-method"]'
    );


  /* =====================================
     PAYMENT BUTTON TEXT
  ===================================== */

  paymentRadios.forEach((radio) => {

    radio.addEventListener(
      "change",
      () => {

        if (!payButton) return;


        if (radio.value === "cod") {

          payButton.textContent =
            "Place Order - Cash on Delivery";

        } else {

          payButton.textContent =
            "Pay Online";

        }

      }
    );

  });


  /* =====================================
     EMPTY CART
  ===================================== */

  if (cart.length === 0) {

    if (payButton) {

      payButton.disabled = true;

      payButton.textContent =
        "Cart is Empty";

    }

  }


  /* =====================================
     CUSTOMER DETAILS
  ===================================== */

  function getCustomerDetails() {

    const name =
      document
        .getElementById("name")
        .value
        .trim();


    const phone =
      document
        .getElementById("phone")
        .value
        .trim();


    const email =
      document
        .getElementById("email")
        .value
        .trim();


    const address =
      document
        .getElementById("address")
        .value
        .trim();


    const area =
      document
        .getElementById("area")
        .value
        .trim();


    const city =
      document
        .getElementById("city")
        .value
        .trim();


    const pincode =
      document
        .getElementById("pincode")
        .value
        .trim();


    const state =
      document
        .getElementById("state")
        .value
        .trim();


    if (!name) {

      alert(
        "Please enter your full name."
      );

      return null;

    }


    if (!/^[0-9]{10}$/.test(phone)) {

      alert(
        "Please enter a valid 10-digit phone number."
      );

      return null;

    }


    if (
      !email ||
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
    ) {

      alert(
        "Please enter a valid email address."
      );

      return null;

    }


    if (!address) {

      alert(
        "Please enter your complete delivery address."
      );

      return null;

    }


    if (!city) {

      alert(
        "Please enter your city."
      );

      return null;

    }


    if (!/^[0-9]{6}$/.test(pincode)) {

      alert(
        "Please enter a valid 6-digit pincode."
      );

      return null;

    }


    if (!state) {

      alert(
        "Please enter your state."
      );

      return null;

    }


    return {

      name,
      phone,
      email,
      address,
      area,
      city,
      pincode,
      state

    };

  }


  /* =====================================
     CREATE COD ORDER
  ===================================== */

  function placeCODOrder(customer) {

    const codOrderId =
      "COD-" +
      Date.now();


    const order = {

      customer,

      items:
        cart,

      total,

      paymentMethod:
        "Cash on Delivery",

      paymentStatus:
        "Payment Pending",

      paymentId:
        null,

      orderId:
        codOrderId,

      orderDate:
        new Date().toISOString()

    };


    localStorage.setItem(
      "lastOrder",
      JSON.stringify(order)
    );


    localStorage.removeItem(
      "cart"
    );


    alert(
      "🎉 Order Placed Successfully!\n\n" +
      "Payment Method: Cash on Delivery\n" +
      "Order ID: " +
      codOrderId
    );


    window.location.href =
      "/order-success";

  }


  /* =====================================
     ONLINE PAYMENT
  ===================================== */

  async function startOnlinePayment(
    customer
  ) {

    try {

      if (status) {

        status.textContent =
          "Creating secure payment...";

      }


      /* CREATE RAZORPAY ORDER */

      const response =
        await fetch(
          "/api/create-order",
          {

            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({
              amount: total
            })

          }
        );


      const responseText =
        await response.text();


      if (!responseText) {

        throw new Error(
          "Create-order API returned empty response."
        );

      }


      let order;

      try {

        order =
          JSON.parse(responseText);

      } catch {

        console.error(
          "Invalid create-order response:",
          responseText
        );

        throw new Error(
          "Create-order API returned invalid response."
        );

      }


      if (!response.ok) {

        throw new Error(
          order.error ||
          "Unable to create payment order."
        );

      }


      /* GET PUBLIC RAZORPAY KEY */

      const keyResponse =
        await fetch(
          "/api/razorpay-key"
        );


      const keyData =
        await keyResponse.json();


      if (
        !keyResponse.ok ||
        !keyData.success ||
        !keyData.keyId
      ) {

        throw new Error(
          keyData.error ||
          "Razorpay Key ID is missing."
        );

      }


      const razorpayKey =
        keyData.keyId;


      /* RAZORPAY OPTIONS */

      const options = {

        key:
          razorpayKey,

        amount:
          order.amount,

        currency:
          order.currency,

        name:
          "Sravs Bakery",

        description:
          "Bakery Order",

        order_id:
          order.id,

        prefill: {

          name:
            customer.name,

          email:
            customer.email,

          contact:
            customer.phone

        },

        notes: {

          address:
            customer.address,

          area:
            customer.area,

          city:
            customer.city,

          state:
            customer.state,

          pincode:
            customer.pincode

        },

        theme: {

          color:
            "#8f4058"

        },


        handler:
          async function(
            paymentResponse
          ) {

            try {

              if (status) {

                status.textContent =
                  "Verifying payment...";

              }


              /* VERIFY PAYMENT */

              const verifyResponse =
                await fetch(
                  "/api/verify-payment",
                  {

                    method: "POST",

                    headers: {

                      "Content-Type":
                        "application/json"

                    },

                    body:
                      JSON.stringify(
                        paymentResponse
                      )

                  }
                );


              const result =
                await verifyResponse.json();


              if (
                !verifyResponse.ok ||
                !result.success
              ) {

                throw new Error(
                  result.error ||
                  "Payment verification failed."
                );

              }


              /* SAVE ONLINE ORDER */

              const onlineOrder = {

                customer,

                items:
                  cart,

                total,

                paymentMethod:
                  "Online Payment",

                paymentStatus:
                  "PAID",

                paymentId:
                  result.paymentId,

                orderId:
                  result.orderId,

                orderDate:
                  new Date().toISOString()

              };


              localStorage.setItem(
                "lastOrder",
                JSON.stringify(
                  onlineOrder
                )
              );


              localStorage.removeItem(
                "cart"
              );


              alert(
                "🎉 Payment Successful!\n\n" +
                "Your order has been placed successfully."
              );


              window.location.href =
                "/order-success";


            } catch (error) {

              console.error(
                "Payment verification error:",
                error
              );


              alert(
                "Payment was received, but verification failed. Please contact the bakery."
              );


              if (status) {

                status.textContent =
                  "Payment verification failed.";

              }


              if (payButton) {

                payButton.disabled =
                  false;

                payButton.textContent =
                  "Pay Online";

              }

            }

          },


        modal: {

          ondismiss: function() {

            if (payButton) {

              payButton.disabled =
                false;

              payButton.textContent =
                "Pay Online";

            }


            if (status) {

              status.textContent =
                "";

            }

          }

        }

      };


      /* OPEN RAZORPAY */

      if (
        typeof window.Razorpay !==
        "function"
      ) {

        throw new Error(
          "Razorpay Checkout failed to load."
        );

      }


      const razorpay =
        new window.Razorpay(
          options
        );


      razorpay.on(
        "payment.failed",
        function(response) {

          console.error(
            "Razorpay payment failed:",
            response.error
          );


          alert(
            response.error?.description ||
            "Payment failed."
          );


          if (payButton) {

            payButton.disabled =
              false;

            payButton.textContent =
              "Pay Online";

          }

        }
      );


      razorpay.open();


    } catch (error) {

      console.error(
        "Online payment error:",
        error
      );


      alert(
        error.message ||
        "Something went wrong while opening Razorpay."
      );


      if (payButton) {

        payButton.disabled =
          false;

        payButton.textContent =
          "Pay Online";

      }


      if (status) {

        status.textContent =
          "";

      }

    }

  }


  /* =====================================
     MAIN BUTTON
  ===================================== */

  payButton?.addEventListener(
    "click",
    async () => {

      if (cart.length === 0) {

        alert(
          "Your cart is empty."
        );

        return;

      }


      const customer =
        getCustomerDetails();


      if (!customer) {

        return;

      }


      if (total <= 0) {

        alert(
          "Invalid order amount."
        );

        return;

      }


      const selectedMethod =
        document.querySelector(
          'input[name="payment-method"]:checked'
        )?.value;


      payButton.disabled =
        true;


      /* COD */

      if (
        selectedMethod === "cod"
      ) {

        payButton.textContent =
          "Placing Order...";


        placeCODOrder(
          customer
        );


        return;

      }


      /* ONLINE */

      payButton.textContent =
        "Opening Payment...";


      await startOnlinePayment(
        customer
      );

    }
  );

</script>


<style>

.payment-page {

  min-height: 100vh;

  padding: 60px 20px;

  background:
    linear-gradient(
      135deg,
      #fff5f5,
      #fff0e6,
      #fdf4ff
    );

}


.payment-container {

  max-width: 700px;

  margin: auto;

}


.payment-header {

  text-align: center;

  margin-bottom: 30px;

}


.payment-header h1 {

  font-size: 38px;

  color: #3b2028;

  margin: 0 0 10px;

}


.payment-header p {

  color: #725c62;

}


.payment-card {

  background: white;

  padding: 35px;

  border-radius: 20px;

  box-shadow:
    0 10px 35px
    rgba(80, 40, 50, 0.12);

}


.section {

  margin-bottom: 35px;

}


.section h2 {

  color: #3b2028;

  font-size: 22px;

  margin-bottom: 20px;

}


.form-group {

  margin-bottom: 17px;

}


.form-group label {

  display: block;

  margin-bottom: 7px;

  color: #4a363c;

  font-size: 14px;

  font-weight: 600;

}


input,
textarea {

  width: 100%;

  box-sizing: border-box;

  padding: 13px;

  border: 1px solid #ead5da;

  border-radius: 8px;

  background: #fffafa;

  font-size: 15px;

  font-family: inherit;

  outline: none;

}


input:focus,
textarea:focus {

  border-color: #c77d92;

}


textarea {

  resize: vertical;

}


.two-column {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 15px;

}


/* PAYMENT METHODS */

.payment-methods {

  display: grid;

  gap: 14px;

}


.payment-option {

  display: block;

  cursor: pointer;

}


.payment-option input {

  position: absolute;

  opacity: 0;

  pointer-events: none;

}


.payment-option-content {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 17px;

  border: 2px solid #ead5da;

  border-radius: 12px;

  background: #fffafa;

  transition: 0.25s;

}


.payment-option-content:hover {

  border-color: #c77d92;

  background: #fff5f7;

}


.payment-option input:checked
+ .payment-option-content {

  border-color: #8f4058;

  background: #fff1f4;

  box-shadow:
    0 5px 15px
    rgba(143, 64, 88, 0.10);

}


.payment-icon {

  font-size: 28px;

}


.payment-option-content strong {

  display: block;

  color: #3b2028;

  font-size: 16px;

  margin-bottom: 4px;

}


.payment-option-content span {

  display: block;

  color: #725c62;

  font-size: 13px;

}


/* ORDER */

.order-section {

  padding-top: 25px;

  border-top: 1px solid #eee;

}


.order-item {

  display: flex;

  justify-content: space-between;

  gap: 15px;

  padding: 10px 0;

  border-bottom:
    1px solid #f0f0f0;

  color: #555;

  font-size: 14px;

}


.order-item strong {

  color: #333;

}


.total-row {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-top: 20px;

  padding-top: 18px;

  border-top: 1px solid #ddd;

  font-size: 18px;

}


.total-row strong {

  color: #8f4058;

  font-size: 24px;

}


/* BUTTON */

#pay-button {

  width: 100%;

  padding: 15px;

  border: none;

  border-radius: 10px;

  background: #8f4058;

  color: white;

  font-size: 17px;

  font-weight: 600;

  cursor: pointer;

  transition: 0.3s;

}


#pay-button:hover {

  background: #682c3e;

}


#pay-button:disabled {

  opacity: 0.6;

  cursor: not-allowed;

}


.payment-status {

  text-align: center;

  color: #725c62;

  font-size: 14px;

  margin-top: 15px;

}


/* MOBILE */

@media (max-width: 600px) {

  .payment-page {

    padding: 40px 15px;

  }


  .payment-card {

    padding: 25px 20px;

  }


  .payment-header h1 {

    font-size: 30px;

  }


  .two-column {

    grid-template-columns: 1fr;

    gap: 0;

  }

}

</style>