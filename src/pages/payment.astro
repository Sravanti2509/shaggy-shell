---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Payment - Sravs Bakery">

  <main class="payment-page">

    <!-- =========================
         HEADER
    ========================= -->

    <section class="payment-header">

      <span class="eyebrow">
        COMPLETE YOUR ORDER
      </span>

      <h1>
        Checkout
      </h1>

      <p>
        Enter your delivery details and choose
        your preferred payment method.
      </p>

    </section>


    <!-- =========================
         CHECKOUT LAYOUT
    ========================= -->

    <section class="checkout-layout">


      <!-- =========================
           CUSTOMER DETAILS
      ========================= -->

      <div class="details-card">

        <div class="section-heading">

          <span>
            DELIVERY DETAILS
          </span>

          <h2>
            Where should we deliver?
          </h2>

        </div>


        <form id="checkout-form">

          <!-- NAME + PHONE -->

          <div class="form-row">

            <div class="field">

              <label for="name">
                Full Name
              </label>

              <input
                id="name"
                name="name"
                type="text"
                placeholder="Enter your full name"
                required
              />

            </div>


            <div class="field">

              <label for="phone">
                Phone Number
              </label>

              <input
                id="phone"
                name="phone"
                type="tel"
                placeholder="Enter your phone number"
                pattern="[0-9]{10}"
                maxlength="10"
                required
              />

            </div>

          </div>


          <!-- EMAIL -->

          <div class="field">

            <label for="email">
              Email Address
            </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="Enter your email address"
              required
            />

          </div>


          <!-- ADDRESS -->

          <div class="field">

            <label for="address">
              Delivery Address
            </label>

            <textarea
              id="address"
              name="address"
              rows="3"
              placeholder="House number, street, landmark..."
              required
            ></textarea>

          </div>


          <!-- AREA + CITY -->

          <div class="form-row">

            <div class="field">

              <label for="area">
                Area
              </label>

              <input
                id="area"
                name="area"
                type="text"
                placeholder="Area"
                required
              />

            </div>


            <div class="field">

              <label for="city">
                City
              </label>

              <input
                id="city"
                name="city"
                type="text"
                placeholder="City"
                required
              />

            </div>

          </div>


          <!-- PIN + STATE -->

          <div class="form-row">

            <div class="field">

              <label for="pincode">
                PIN Code
              </label>

              <input
                id="pincode"
                name="pincode"
                type="text"
                placeholder="6-digit PIN"
                maxlength="6"
                pattern="[0-9]{6}"
                required
              />

            </div>


            <div class="field">

              <label for="state">
                State
              </label>

              <input
                id="state"
                name="state"
                type="text"
                placeholder="State"
                required
              />

            </div>

          </div>

        </form>

      </div>


      <!-- =========================
           ORDER SIDE
      ========================= -->

      <aside class="order-side">


        <!-- =========================
             ORDER SUMMARY
        ========================= -->

        <div class="order-card">

          <div class="section-heading small">

            <span>
              YOUR ORDER
            </span>

            <h2>
              Order Summary
            </h2>

          </div>


          <div id="order-items"></div>


          <div class="summary-row">

            <span>
              Subtotal
            </span>

            <strong id="subtotal">
              ₹0
            </strong>

          </div>


          <div class="summary-row">

            <span>
              Delivery
            </span>

            <span class="free">
              FREE
            </span>

          </div>


          <div class="total-row">

            <span>
              Total
            </span>

            <strong id="total">
              ₹0
            </strong>

          </div>

        </div>


        <!-- =========================
             PAYMENT
        ========================= -->

        <div class="payment-card">

          <div class="section-heading small">

            <span>
              PAYMENT
            </span>

            <h2>
              Choose how to pay
            </h2>

          </div>


          <!-- ONLINE -->

          <button
            id="online-payment"
            class="payment-option"
            type="button"
          >

            <div class="payment-icon">
              ₹
            </div>

            <div class="payment-text">

              <strong>
                Online Payment
              </strong>

              <span>
                UPI · Cards · Net Banking
              </span>

            </div>

            <span class="arrow">
              →
            </span>

          </button>


          <!-- COD -->

          <button
            id="cod-payment"
            class="payment-option"
            type="button"
          >

            <div class="payment-icon cod">
              ✓
            </div>

            <div class="payment-text">

              <strong>
                Cash on Delivery
              </strong>

              <span>
                Pay when your order arrives
              </span>

            </div>

            <span class="arrow">
              →
            </span>

          </button>


          <p class="secure">
            Secure checkout · Freshly prepared with care
          </p>

        </div>

      </aside>

    </section>

  </main>


  <!-- =========================
       RAZORPAY
  ========================= -->

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>


  <script>

    /* =========================
       GET CART
    ========================= */

    function getCart() {

      return JSON.parse(
        localStorage.getItem("cart") || "[]"
      );

    }


    /* =========================
       GET TOTAL
    ========================= */

    function getTotal() {

      const cart = getCart();

      let total = 0;


      cart.forEach((item) => {

        const price = Number(
          String(item.price)
            .replace(/[^0-9.]/g, "")
        );

        const quantity =
          Number(item.quantity) || 1;

        total += price * quantity;

      });


      return total;

    }


    /* =========================
       DISPLAY ORDER
    ========================= */

    function displayOrder() {

      const cart = getCart();

      const container =
        document.getElementById(
          "order-items"
        );

      const subtotal =
        document.getElementById(
          "subtotal"
        );

      const totalElement =
        document.getElementById(
          "total"
        );


      if (cart.length === 0) {

        container.innerHTML = `

          <div class="empty-order">

            Your cart is empty.

            <a href="/menu">
              Return to Menu
            </a>

          </div>

        `;

        subtotal.textContent = "₹0";

        totalElement.textContent = "₹0";

        return;

      }


      let total = 0;

      container.innerHTML = "";


      cart.forEach((item) => {

        const price = Number(
          String(item.price)
            .replace(/[^0-9.]/g, "")
        );

        const quantity =
          Number(item.quantity) || 1;

        const itemTotal =
          price * quantity;


        total += itemTotal;


        container.innerHTML += `

          <div class="order-item">

            <div>

              <span>
                ${item.name}
              </span>

              <small>
                × ${quantity}
              </small>

            </div>

            <strong>
              ₹${itemTotal}
            </strong>

          </div>

        `;

      });


      subtotal.textContent =
        `₹${total}`;

      totalElement.textContent =
        `₹${total}`;

    }


    /* =========================
       CUSTOMER DETAILS
    ========================= */

    function getCustomerDetails() {

      const form =
        document.getElementById(
          "checkout-form"
        );


      if (!form.checkValidity()) {

        form.reportValidity();

        return null;

      }


      const formData =
        new FormData(form);


      return {

        name:
          String(
            formData.get("name") || ""
          ).trim(),

        phone:
          String(
            formData.get("phone") || ""
          ).trim(),

        email:
          String(
            formData.get("email") || ""
          ).trim(),

        address:
          String(
            formData.get("address") || ""
          ).trim(),

        area:
          String(
            formData.get("area") || ""
          ).trim(),

        city:
          String(
            formData.get("city") || ""
          ).trim(),

        pincode:
          String(
            formData.get("pincode") || ""
          ).trim(),

        state:
          String(
            formData.get("state") || ""
          ).trim()

      };

    }


    /* =========================
       CREATE ORDER ID
    ========================= */

    function generateOrderId() {

      return (
        "SRAVS-" +
        Date.now()
          .toString()
          .slice(-8)
      );

    }


    /* =========================
       ONLINE PAYMENT
    ========================= */

    async function payOnline() {

      const cart = getCart();


      if (cart.length === 0) {

        alert(
          "Your cart is empty!"
        );

        window.location.href =
          "/menu";

        return;

      }


      const customer =
        getCustomerDetails();


      if (!customer) return;


      const total =
        getTotal();


      const button =
        document.getElementById(
          "online-payment"
        );


      button.disabled = true;


      try {

        const response =
          await fetch(
            "/api/create-order",
            {

              method: "POST",

              headers: {

                "Content-Type":
                  "application/json"

              },

              body: JSON.stringify({

                amount:
                  total,

                customer:
                  customer

              })

            }
          );


        const text =
          await response.text();


        let data;


        try {

          data =
            JSON.parse(text);

        }

        catch {

          throw new Error(
            "Payment server returned an invalid response."
          );

        }


        if (
          !response.ok ||
          !data.id
        ) {

          throw new Error(
            data.error ||
            "Unable to create payment order."
          );

        }


        const razorpay =
          new Razorpay({

            key:
              import.meta.env
                .PUBLIC_RAZORPAY_KEY_ID,

            amount:
              data.amount,

            currency:
              "INR",

            name:
              "Sravs Bakery",

            description:
              "Bakery Order",

            order_id:
              data.id,


            prefill: {

              name:
                customer.name,

              email:
                customer.email,

              contact:
                customer.phone

            },


            notes: {

              address:
                customer.address,

              area:
                customer.area,

              city:
                customer.city,

              pincode:
                customer.pincode,

              state:
                customer.state

            },


            theme: {

              color:
                "#292621"

            },


            handler:
              async function(response) {

                try {

                  const verify =
                    await fetch(
                      "/api/verify-payment",
                      {

                        method: "POST",

                        headers: {

                          "Content-Type":
                            "application/json"

                        },

                        body:
                          JSON.stringify({

                            razorpay_order_id:
                              response.razorpay_order_id,

                            razorpay_payment_id:
                              response.razorpay_payment_id,

                            razorpay_signature:
                              response.razorpay_signature,

                            customer:
                              customer,

                            cart:
                              cart,

                            amount:
                              total

                          })

                      }
                    );


                  const text =
                    await verify.text();


                  let result;


                  try {

                    result =
                      JSON.parse(text);

                  }

                  catch {

                    throw new Error(
                      "Payment verification returned an invalid response."
                    );

                  }


                  if (!verify.ok) {

                    throw new Error(
                      result.error ||
                      "Payment verification failed."
                    );

                  }


                  const order = {

                    orderId:
                      response.razorpay_order_id,

                    customer:
                      customer,

                    items:
                      cart,

                    amount:
                      total,

                    paymentMethod:
                      "Online Payment",

                    paymentStatus:
                      "PAID",

                    paymentId:
                      response.razorpay_payment_id,

                    razorpayOrderId:
                      response.razorpay_order_id,

                    date:
                      new Date()
                        .toISOString()

                  };


                  localStorage.setItem(
                    "lastOrder",
                    JSON.stringify(order)
                  );


                  localStorage.removeItem(
                    "cart"
                  );


                  showOrderSuccess(order);

                }

                catch(error) {

                  console.error(error);

                  alert(
                    error.message ||
                    "Payment verification failed."
                  );

                  button.disabled =
                    false;

                }

              }

          });


        razorpay.on(
          "payment.failed",
          function() {

            alert(
              "Payment failed. Please try again."
            );

            button.disabled =
              false;

          }
        );


        razorpay.open();

      }

      catch(error) {

        console.error(error);

        alert(
          error.message ||
          "Unable to start payment."
        );

        button.disabled =
          false;

      }

    }


    /* =========================
       CASH ON DELIVERY
    ========================= */

    function cashOnDelivery() {

      const cart = getCart();


      if (cart.length === 0) {

        alert(
          "Your cart is empty!"
        );

        window.location.href =
          "/menu";

        return;

      }


      const customer =
        getCustomerDetails();


      if (!customer) return;


      const total =
        getTotal();


      const confirmed =
        confirm(
          "Place your order with Cash on Delivery?"
        );


      if (!confirmed) return;


      const orderId =
        generateOrderId();


      const order = {

        orderId:
          orderId,

        customer:
          customer,

        items:
          cart,

        amount:
          total,

        paymentMethod:
          "Cash on Delivery",

        paymentStatus:
          "PENDING",

        paymentId:
          "Not Applicable",

        date:
          new Date()
            .toISOString()

      };


      localStorage.setItem(
        "lastOrder",
        JSON.stringify(order)
      );


      localStorage.removeItem(
        "cart"
      );


      showOrderSuccess(order);

    }


    /* =========================
       SUCCESS SCREEN
    ========================= */

    function showOrderSuccess(order) {

      const itemsHTML =
        order.items
          .map((item) => {

            const price =
              Number(
                String(item.price)
                  .replace(
                    /[^0-9.]/g,
                    ""
                  )
              );

            const quantity =
              Number(item.quantity) || 1;

            const itemTotal =
              price * quantity;


            return `

              <div class="success-item">

                <div class="success-item-name">

                  <strong>
                    ${item.name}
                  </strong>

                  <span>
                    Quantity: ${quantity}
                  </span>

                </div>

                <strong>
                  ₹${itemTotal}
                </strong>

              </div>

            `;

          })
          .join("");


      document.body.innerHTML = `

        <div class="success-overlay">

          <div class="success-modal">


            <!-- SUCCESS HEADER -->

            <div class="success-header">

              <div class="success-check">
                ✓
              </div>

              <span class="success-eyebrow">
                ORDER CONFIRMED
              </span>

              <h1>
                Order Placed Successfully
              </h1>

              <p>
                Thank you for ordering from
                Sravs Bakery.
              </p>

            </div>


            <!-- ORDER ID -->

            <div class="order-id-box">

              <div>

                <span>
                  ORDER ID
                </span>

                <strong>
                  ${order.orderId}
                </strong>

              </div>

              <span class="order-confirmed">
                CONFIRMED
              </span>

            </div>


            <!-- DELIVERY DETAILS -->

            <div class="success-section">

              <div class="success-title">
                DELIVERY DETAILS
              </div>


              <div class="delivery-grid">

                <div>

                  <span>
                    Customer Name
                  </span>

                  <strong>
                    ${order.customer.name}
                  </strong>

                </div>


                <div>

                  <span>
                    Phone Number
                  </span>

                  <strong>
                    ${order.customer.phone}
                  </strong>

                </div>


                <div>

                  <span>
                    Email Address
                  </span>

                  <strong>
                    ${order.customer.email}
                  </strong>

                </div>


                <div>

                  <span>
                    PIN Code
                  </span>

                  <strong>
                    ${order.customer.pincode}
                  </strong>

                </div>


                <div class="full-width">

                  <span>
                    Delivery Address
                  </span>

                  <strong>

                    ${order.customer.address},
                    ${order.customer.area},
                    ${order.customer.city},
                    ${order.customer.state}
                    - ${order.customer.pincode}

                  </strong>

                </div>

              </div>

            </div>


            <!-- ORDER DETAILS -->

            <div class="success-section">

              <div class="success-title">
                ORDER DETAILS
              </div>


              <div class="success-items">

                ${itemsHTML}

              </div>


              <div class="success-total">

                <span>
                  Total Amount
                </span>

                <strong>
                  ₹${order.amount}
                </strong>

              </div>

            </div>


            <!-- PAYMENT DETAILS -->

            <div class="success-section">

              <div class="success-title">
                PAYMENT DETAILS
              </div>


              <div class="payment-info">

                <div>

                  <span>
                    Payment Method
                  </span>

                  <strong>
                    ${order.paymentMethod}
                  </strong>

                </div>


                <div>

                  <span>
                    Payment Status
                  </span>

                  <strong
                    class="${
                      order.paymentStatus === "PAID"
                        ? "payment-paid"
                        : "payment-pending"
                    }"
                  >
                    ${order.paymentStatus}
                  </strong>

                </div>


                ${
                  order.paymentId &&
                  order.paymentId !== "Not Applicable"
                    ? `

                      <div class="full-width">

                        <span>
                          Payment ID
                        </span>

                        <strong>
                          ${order.paymentId}
                        </strong>

                      </div>

                    `
                    : ""
                }

              </div>

            </div>


            <!-- FOOTER -->

            <div class="success-footer">

              <p>

                ${
                  order.paymentMethod ===
                  "Cash on Delivery"

                    ? "Please keep the payment ready when your order is delivered."

                    : "Your payment has been successfully received and your order is confirmed."
                }

              </p>


              <button
                type="button"
                onclick="window.location.href='/'"
              >
                Back to Home
              </button>

            </div>


          </div>

        </div>

      `;

    }


    /* =========================
       EVENTS
    ========================= */

    document
      .getElementById(
        "online-payment"
      )
      .addEventListener(
        "click",
        payOnline
      );


    document
      .getElementById(
        "cod-payment"
      )
      .addEventListener(
        "click",
        cashOnDelivery
      );


    /* =========================
       LOAD
    ========================= */

    displayOrder();

  </script>


  <style>

    /* =========================
       PAGE
    ========================= */

    :global(.payment-page) {

      min-height: 100vh;

      padding:
        70px 25px 100px;

      background:
        linear-gradient(
          180deg,
          #faf8f3 0%,
          #ffffff 55%,
          #faf8f3 100%
        );

      color: #292621;

    }


    /* =========================
       HEADER
    ========================= */

    :global(.payment-header) {

      max-width: 700px;

      margin: 0 auto 55px;

      text-align: center;

    }


    :global(.eyebrow) {

      color: #a47c45;

      font-size: 10px;

      font-weight: 700;

      letter-spacing: 3px;

    }


    :global(.payment-header h1) {

      margin:
        13px 0 10px;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 50px;

      font-weight: 400;

      letter-spacing: -1px;

    }


    :global(.payment-header p) {

      margin: auto;

      color: #777066;

      font-size: 14px;

      line-height: 1.8;

    }


    /* =========================
       LAYOUT
    ========================= */

    :global(.checkout-layout) {

      max-width: 1100px;

      margin: auto;

      display: grid;

      grid-template-columns:
        1.25fr .75fr;

      gap: 30px;

      align-items: start;

    }


    /* =========================
       CARDS
    ========================= */

    :global(.details-card),
    :global(.order-card),
    :global(.payment-card) {

      background: #ffffff;

      border:
        1px solid #e2dbd1;

      padding: 30px;

    }


    :global(.order-card),
    :global(.payment-card) {

      margin-bottom: 20px;

    }


    :global(.payment-card) {

      background: #f5f1e9;

    }


    /* =========================
       HEADINGS
    ========================= */

    :global(.section-heading span) {

      color: #a47c45;

      font-size: 9px;

      font-weight: 700;

      letter-spacing: 2.5px;

    }


    :global(.section-heading h2) {

      margin:
        8px 0 28px;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 25px;

      font-weight: 400;

    }


    :global(.section-heading.small h2) {

      font-size: 22px;

    }


    /* =========================
       FORM
    ========================= */

    :global(.form-row) {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 18px;

    }


    :global(.field) {

      margin-bottom: 20px;

    }


    :global(.field label) {

      display: block;

      margin-bottom: 7px;

      color: #4d463e;

      font-size: 11px;

      font-weight: 600;

      letter-spacing: .3px;

    }


    :global(.field input),
    :global(.field textarea) {

      width: 100%;

      box-sizing: border-box;

      padding:
        13px 14px;

      border:
        1px solid #d9d1c6;

      outline: none;

      background: #fcfbf8;

      color: #292621;

      font-family:
        Arial,
        sans-serif;

      font-size: 13px;

      transition:
        border-color .2s ease,
        background .2s ease;

    }


    :global(.field textarea) {

      resize: vertical;

      min-height: 90px;

    }


    :global(.field input:focus),
    :global(.field textarea:focus) {

      border-color: #a47c45;

      background: #ffffff;

    }


    :global(.field input::placeholder),
    :global(.field textarea::placeholder) {

      color: #aaa196;

    }


    /* =========================
       ORDER
    ========================= */

    :global(.order-item) {

      display: flex;

      justify-content:
        space-between;

      gap: 20px;

      padding:
        14px 0;

      border-bottom:
        1px solid #eee8df;

      font-size: 13px;

    }


    :global(.order-item div) {

      display: flex;

      flex-direction: column;

      gap: 4px;

    }


    :global(.order-item small) {

      color: #968d82;

      font-size: 10px;

    }


    :global(.order-item strong) {

      font-family:
        Georgia,
        serif;

      font-weight: 500;

      white-space: nowrap;

    }


    :global(.summary-row) {

      display: flex;

      justify-content:
        space-between;

      margin-top: 18px;

      color: #756e64;

      font-size: 13px;

    }


    :global(.summary-row strong) {

      color: #292621;

      font-family:
        Georgia,
        serif;

      font-weight: 500;

    }


    :global(.free) {

      color: #71805d;

      font-size: 10px;

      font-weight: 700;

      text-transform: uppercase;

    }


    :global(.total-row) {

      display: flex;

      justify-content:
        space-between;

      align-items: center;

      margin-top: 22px;

      padding-top: 20px;

      border-top:
        1px solid #d9d1c6;

    }


    :global(.total-row span) {

      font-family:
        Georgia,
        serif;

      font-size: 19px;

    }


    :global(.total-row strong) {

      font-family:
        Georgia,
        serif;

      font-size: 27px;

      font-weight: 500;

    }


    /* =========================
       PAYMENT BUTTONS
    ========================= */

    :global(.payment-option) {

      width: 100%;

      display: flex;

      align-items: center;

      gap: 14px;

      padding: 17px;

      margin-bottom: 13px;

      border:
        1px solid #d7cec0;

