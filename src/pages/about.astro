---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About - Sravs Bakery">

  <main class="about">

    <section class="about-content">

      <p class="subtitle">ABOUT US</p>

      <h1>Welcome to My Bakery</h1>

      <p>
        We believe every day deserves something sweet.
        At My Bakery, we prepare fresh and delicious
        cakes, pastries, puffs, sandwiches, cookies and
        refreshing milkshakes.
      </p>

      <p>
        Our treats are made with quality ingredients,
        care and lots of love. Whether you are celebrating
        a special occasion or simply craving something
        delicious, we are here to make your day sweeter.
      </p>

    </section>

  </main>

</Layout>

<style>
  .about {
    min-height: 100vh;
    padding: 80px 40px;

    background: linear-gradient(
      135deg,
      #fff5f5,
      #fff0e6,
      #fdf4ff
    );

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about-content {
    max-width: 800px;
    padding: 50px;

    text-align: center;

    background: rgba(255, 255, 255, 0.88);

    border-radius: 20px;

    box-shadow:
      0 10px 35px rgba(80, 40, 50, 0.12);
  }

  .subtitle {
    font-size: 14px;
    letter-spacing: 4px;
    font-weight: bold;
    color: #9b4d63;
    margin-bottom: 15px;
  }

  h1 {
    font-size: 44px;
    color: #3b2028;
    margin: 10px 0 25px;
  }

  p:not(.subtitle) {
    color: #66545a;
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 20px;
  }

  @media (max-width: 600px) {
    .about {
      padding: 50px 20px;
    }

    .about-content {
      padding: 30px 20px;
    }

    h1 {
      font-size: 32px;
    }

    p:not(.subtitle) {
      font-size: 15px;
    }
  }
</style>