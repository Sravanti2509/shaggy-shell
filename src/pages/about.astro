---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About - Sravs Bakery">

  <main class="about-page">

    <!-- =========================
         ABOUT HERO
    ========================== -->

    <section class="about-hero">

      <div class="about-hero-content">

        <p class="eyebrow">
          THE STORY BEHIND SRAVS BAKERY
        </p>

        <h1>
          A little care in every
          <span>bake.</span>
        </h1>

        <p class="hero-text">
          At Sravs Bakery, we believe that the best bakery experiences
          are created from simple things — quality ingredients,
          thoughtful preparation and a genuine love for what we do.
        </p>

      </div>

    </section>


    <!-- =========================
         OUR STORY
    ========================== -->

    <section class="story-section">

      <div class="story-image">

        <img
          src="/products/icon6.jpg"
          alt="Freshly baked treats at Sravs Bakery"
        />

      </div>


      <div class="story-content">

        <p class="eyebrow">
          OUR STORY
        </p>

        <h2>
          More than just something sweet.
        </h2>

        <p>
          Sravs Bakery was created with a simple purpose — to bring
          freshly prepared bakery favorites to people who appreciate
          good food and meaningful moments.
        </p>

        <p>
          From beautifully crafted cakes and creamy pastries to
          savory puffs, cookies and everyday treats, we focus on
          creating food that feels fresh, comforting and memorable.
        </p>

        <p>
          Whether you are celebrating a birthday, sharing dessert
          with family or simply treating yourself after a long day,
          we want every visit to feel special.
        </p>

      </div>

    </section>


    <!-- =========================
         PHILOSOPHY
    ========================== -->

    <section class="philosophy-section">

      <div class="section-heading">

        <p class="eyebrow">
          WHAT WE BELIEVE
        </p>

        <h2>
          Simple principles.<br />
          <span>Beautiful results.</span>
        </h2>

      </div>


      <div class="values-grid">

        <article class="value-card">

          <span class="number">01</span>

          <h3>
            Quality First
          </h3>

          <p>
            We believe great taste begins with quality ingredients.
            Every ingredient is selected with care to create a
            better bakery experience.
          </p>

        </article>


        <article class="value-card">

          <span class="number">02</span>

          <h3>
            Freshness Matters
          </h3>

          <p>
            Freshly prepared food simply tastes better. We put
            freshness at the heart of everything we create.
          </p>

        </article>


        <article class="value-card">

          <span class="number">03</span>

          <h3>
            Attention to Detail
          </h3>

          <p>
            From preparation to presentation, we care about the
            details that turn a simple treat into something special.
          </p>

        </article>


        <article class="value-card">

          <span class="number">04</span>

          <h3>
            Made for Moments
          </h3>

          <p>
            Food becomes more meaningful when it is shared. Our
            creations are made for celebrations, gatherings and
            everyday moments.
          </p>

        </article>

      </div>

    </section>


    <!-- =========================
         EXPERIENCE
    ========================== -->

    <section class="experience-section">

      <div class="experience-content">

        <p class="eyebrow">
          THE SRAVS EXPERIENCE
        </p>

        <h2>
          Fresh flavors.<br />
          Thoughtful presentation.
        </h2>

        <p>
          We want every part of your experience with Sravs Bakery
          to feel effortless — from discovering something you love
          to placing your order and enjoying the final bite.
        </p>

        <a href="/menu" class="primary-button">
          Explore Our Menu
        </a>

      </div>


      <div class="experience-list">

        <div class="experience-item">

          <span>01</span>

          <div>
            <strong>Freshly Prepared</strong>
            <p>
              Carefully prepared bakery favorites.
            </p>
          </div>

        </div>


        <div class="experience-item">

          <span>02</span>

          <div>
            <strong>Thoughtfully Crafted</strong>
            <p>
              Attention to flavor, texture and presentation.
            </p>
          </div>

        </div>


        <div class="experience-item">

          <span>03</span>

          <div>
            <strong>Made to Share</strong>
            <p>
              Perfect for everyday treats and celebrations.
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- =========================
         CLOSING CTA
    ========================== -->

    <section class="about-cta">

      <div>

        <p class="eyebrow">
          SOMETHING DELICIOUS AWAITS
        </p>

        <h2>
          Ready to find your favorite?
        </h2>

        <p>
          Explore our collection of freshly prepared cakes,
          pastries and bakery favorites.
        </p>

        <a href="/menu" class="cta-button">
          Explore Our Menu →
        </a>

      </div>

    </section>

  </main>

</Layout>


<style>

  /* =========================
     COMMON
  ========================== */

  * {
    box-sizing: border-box;
  }


  .about-page {
    background: #ffffff;
    color: #0b1f3a;
  }


  .eyebrow {
    margin: 0 0 18px;
    color: #8a6a38;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
  }


  /* =========================
     HERO
  ========================== */

  .about-hero {
    min-height: 470px;
    padding: 90px 8%;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
      linear-gradient(
        135deg,
        #ffffff 0%,
        #f7fbff 55%,
        #eaf2f8 100%
      );
  }


  .about-hero-content {
    max-width: 850px;
  }


  .about-hero h1 {
    margin: 0;

    color: #0b1f3a;

    font-size: clamp(46px, 6vw, 72px);

    line-height: 1.08;

    letter-spacing: -2px;
  }


  .about-hero h1 span {
    color: #547896;
  }


  .hero-text {
    max-width: 680px;

    margin: 28px auto 0;

    color: #5d6c7b;

    font-size: 17px;

    line-height: 1.8;
  }


  /* =========================
     STORY
  ========================== */

  .story-section {
    display: grid;

    grid-template-columns: 1fr 1fr;

    min-height: 620px;

    background: #ffffff;
  }


  .story-image {
    min-height: 620px;

    overflow: hidden;
  }


  .story-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.5s ease;
  }


  .story-image:hover img {
    transform: scale(1.03);
  }


  .story-content {
    padding: 80px 10%;

    display: flex;
    flex-direction: column;
    justify-content: center;
  }


  .story-content h2 {
    margin: 0 0 25px;

    color: #0b1f3a;

    font-size: clamp(36px, 4vw, 52px);

    line-height: 1.15;

    letter-spacing: -1px;
  }


  .story-content p:not(.eyebrow) {
    max-width: 560px;

    color: #627181;

    font-size: 15px;

    line-height: 1.85;

    margin: 0 0 17px;
  }


  /* =========================
     PHILOSOPHY
  ========================== */

  .philosophy-section {
    padding: 110px 8%;

    background: #f7f9fb;
  }


  .section-heading {
    max-width: 650px;

    margin-bottom: 55px;
  }


  .section-heading h2 {
    margin: 0;

    color: #0b1f3a;

    font-size: clamp(38px, 4vw, 54px);

    line-height: 1.12;

    letter-spacing: -1px;
  }


  .section-heading h2 span {
    color: #547896;
  }


  .values-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 1px;

    background: #dce3e9;

    border: 1px solid #dce3e9;
  }


  .value-card {
    min-height: 290px;

    padding: 35px;

    background: #ffffff;
  }


  .number {
    display: block;

    margin-bottom: 50px;

    color: #8a6a38;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 1px;
  }


  .value-card h3 {
    margin: 0 0 15px;

    color: #0b1f3a;

    font-size: 20px;
  }


  .value-card p {
    margin: 0;

    color: #718090;

    font-size: 13px;

    line-height: 1.75;
  }


  /* =========================
     EXPERIENCE
  ========================== */

  .experience-section {
    padding: 110px 8%;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 100px;

    align-items: center;

    background: #ffffff;
  }


  .experience-content h2 {
    margin: 0 0 25px;

    color: #0b1f3a;

    font-size: clamp(38px, 4vw, 54px);

    line-height: 1.12;

    letter-spacing: -1px;
  }


  .experience-content > p:not(.eyebrow) {
    max-width: 530px;

    margin: 0 0 30px;

    color: #687787;

    font-size: 15px;

    line-height: 1.8;
  }


  .primary-button {
    display: inline-block;

    padding: 15px 27px;

    background: #0b1f3a;

    color: #ffffff;

    text-decoration: none;

    border-radius: 4px;

    font-size: 13px;

    font-weight: 700;

    transition: 0.25s;
  }


  .primary-button:hover {
    background: #18395d;

    transform: translateY(-2px);
  }


  .experience-list {
    border-top: 1px solid #dce3e9;
  }


  .experience-item {
    display: grid;

    grid-template-columns: 50px 1fr;

    gap: 15px;

    padding: 28px 0;

    border-bottom: 1px solid #dce3e9;
  }


  .experience-item > span {
    color: #8a6a38;

    font-size: 11px;

    font-weight: 700;
  }


  .experience-item strong {
    color: #0b1f3a;

    font-size: 17px;
  }


  .experience-item p {
    margin: 7px 0 0;

    color: #788594;

    font-size: 13px;
  }


  /* =========================
     CTA
  ========================== */

  .about-cta {
    padding: 100px 25px;

    text-align: center;

    background: #0b1f3a;
  }


  .about-cta > div {
    max-width: 700px;

    margin: auto;
  }


  .about-cta .eyebrow {
    color: #c9a96e;
  }


  .about-cta h2 {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: clamp(38px, 5vw, 55px);

    line-height: 1.15;
  }


  .about-cta p:not(.eyebrow) {
    margin: 0 auto 30px;

    max-width: 550px;

    color: #c8d3de;

    line-height: 1.7;

    font-size: 15px;
  }


  .cta-button {
    display: inline-block;

    padding: 15px 28px;

    background: #ffffff;

    color: #0b1f3a;

    text-decoration: none;

    border-radius: 4px;

    font-size: 13px;

    font-weight: 700;

    transition: 0.25s;
  }


  .cta-button:hover {
    background: #eaf2f8;

    transform: translateY(-2px);
  }


  /* =========================
     TABLET
  ========================== */

  @media (max-width: 1000px) {

    .story-section {
      grid-template-columns: 1fr;
    }


    .story-image {
      min-height: 480px;
    }


    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }


    .experience-section {
      gap: 60px;
    }

  }


  /* =========================
     MOBILE
  ========================== */

  @media (max-width: 700px) {

    .about-hero {
      min-height: auto;

      padding: 65px 20px;
    }


    .about-hero h1 {
      font-size: 43px;
      letter-spacing: -1.2px;
    }


    .hero-text {
      font-size: 15px;
      line-height: 1.75;
    }


    .story-image {
      min-height: 380px;
    }


    .story-content {
      padding: 65px 25px;
    }


    .story-content h2 {
      font-size: 37px;
    }


    .philosophy-section {
      padding: 75px 20px;
    }


    .values-grid {
      grid-template-columns: 1fr;
    }


    .value-card {
      min-height: auto;
      padding: 30px;
    }


    .number {
      margin-bottom: 25px;
    }


    .experience-section {
      padding: 75px 25px;

      grid-template-columns: 1fr;

      gap: 55px;
    }


    .experience-content h2 {
      font-size: 38px;
    }


    .about-cta {
      padding: 75px 20px;
    }

  }


  /* =========================
     SMALL PHONES
  ========================== */

  @media (max-width: 380px) {

    .about-hero {
      padding: 55px 18px;
    }


    .about-hero h1 {
      font-size: 36px;
    }


    .story-content {
      padding: 55px 20px;
    }


    .story-content h2 {
      font-size: 32px;
    }


    .experience-section {
      padding: 60px 20px;
    }

  }

</style>