---
import Header from "../components/Header.astro";
---

<html>
  <head>
    <title>Contact - My Bakery</title>
  </head>

  <body>

    <Header />

    <main class="contact">

      <section class="contact-header">
        <p class="subtitle">CONTACT US</p>

        <h1>Get in Touch</h1>

        <p>
          Have a question or want to place an order?
          We'd love to hear from you.
        </p>
      </section>


      <section class="contact-container">

        <div class="contact-info">

          <h2>Visit Us</h2>

          <p>
            Hyderabad, Telangana
          </p>

          <p>
            +91 98765 43210
          </p>

          <p>
            mybakery@gmail.com
          </p>

          <p>
            Monday - Sunday: 9:00 AM - 9:00 PM
          </p>

        </div>


        <div class="contact-form">

          <h2>Send Us a Message</h2>

          <form>

            <input
              type="text"
              placeholder="Your Name"
              required
            />

            <input
              type="email"
              placeholder="Your Email"
              required
            />

            <input
              type="text"
              placeholder="Subject"
              required
            />

            <textarea
              placeholder="Your Message"
              rows="5"
              required
            ></textarea>

            <button type="submit">
              Send Message
            </button>

          </form>

        </div>

      </section>

    </main>

  </body>
</html>

<style>
  .contact {
    min-height: 100vh;
    padding: 80px 40px;
    background: linear-gradient(
      135deg,
      #fff5f5,
      #fff0e6,
      #fdf4ff
    );
  }

  .contact-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 55px;
  }

  .subtitle {
    font-size: 14px;
    letter-spacing: 4px;
    font-weight: bold;
    color: #9b4d63;
  }

  .contact-header h1 {
    font-size: 44px;
    margin: 15px 0;
    color: #3b2028;
  }

  .contact-header p:last-child {
    color: #725c62;
    font-size: 17px;
    line-height: 1.7;
  }

  .contact-container {
    max-width: 1000px;
    margin: auto;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .contact-info,
  .contact-form {
    padding: 35px;
    border-radius: 18px;

    background: rgba(255, 255, 255, 0.85);

    box-shadow:
      0 10px 30px rgba(80, 40, 50, 0.12);
  }

  .contact-info h2,
  .contact-form h2 {
    color: #3b2028;
    margin-bottom: 25px;
  }

  .contact-info p {
    color: #66545a;
    margin: 22px 0;
    font-size: 16px;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  input,
  textarea {
    width: 100%;
    box-sizing: border-box;

    padding: 14px;

    border: 1px solid #ead5da;
    border-radius: 8px;

    background: #fffafa;

    font-size: 15px;
    font-family: inherit;

    outline: none;
  }

  input:focus,
  textarea:focus {
    border-color: #c77d92;
  }

  textarea {
    resize: vertical;
  }

  button {
    padding: 14px;

    border: none;
    border-radius: 8px;

    background: #8f4058;
    color: white;

    font-size: 15px;
    cursor: pointer;

    transition: 0.3s;
  }

  button:hover {
    background: #682c3e;
    transform: translateY(-2px);
  }

  @media (max-width: 700px) {
    .contact {
      padding: 55px 20px;
    }

    .contact-container {
      grid-template-columns: 1fr;
    }

    .contact-header h1 {
      font-size: 32px;
    }
  }
</style>