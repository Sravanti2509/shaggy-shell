---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact - Sravs Bakery">

  <main class="contact-page">

    <!-- =========================
         HERO
    ========================== -->

    <section class="contact-hero">

      <div class="hero-inner">

        <p class="eyebrow">
          WE'D LOVE TO HEAR FROM YOU
        </p>

        <h1>
          Let's make something
          <span>delicious together.</span>
        </h1>

        <p class="hero-description">
          Whether you have a question, want to know more about
          our menu, or simply want to say hello, our team is here
          to help.
        </p>

      </div>

    </section>


    <!-- =========================
         CONTACT DETAILS + FORM
    ========================== -->

    <section class="contact-section">

      <!-- LEFT -->

      <div class="contact-details">

        <p class="eyebrow">
          GET IN TOUCH
        </p>

        <h2>
          Visit, call or<br />
          write to us.
        </h2>

        <p class="details-intro">
          We are always happy to help with orders, questions,
          celebrations and everything in between.
        </p>


        <!-- LOCATION -->

        <div class="detail-item">

          <span class="detail-number">
            01
          </span>

          <div>

            <h3>
              Visit Us
            </h3>

            <p>
              Hyderabad, Telangana
            </p>

          </div>

        </div>


        <!-- PHONE -->

        <div class="detail-item">

          <span class="detail-number">
            02
          </span>

          <div>

            <h3>
              Call Us
            </h3>

            <p>
              +91 98765 43210
            </p>

          </div>

        </div>


        <!-- EMAIL -->

        <div class="detail-item">

          <span class="detail-number">
            03
          </span>

          <div>

            <h3>
              Email
            </h3>

            <p>
              mybakery@gmail.com
            </p>

          </div>

        </div>


        <!-- HOURS -->

        <div class="detail-item">

          <span class="detail-number">
            04
          </span>

          <div>

            <h3>
              Opening Hours
            </h3>

            <p>
              Monday – Sunday<br />
              9:00 AM – 9:00 PM
            </p>

          </div>

        </div>

      </div>


      <!-- RIGHT FORM -->

      <div class="form-wrapper">

        <div class="form-header">

          <p class="eyebrow">
            SEND A MESSAGE
          </p>

          <h2>
            How can we help?
          </h2>

          <p>
            Fill in the details below and we'll get back to you.
          </p>

        </div>


        <form id="contact-form">

          <div class="form-row">

            <div class="field">

              <label for="name">
                Your Name
              </label>

              <input
                id="name"
                type="text"
                placeholder="Enter your name"
                required
              />

            </div>


            <div class="field">

              <label for="email">
                Email Address
              </label>

              <input
                id="email"
                type="email"
                placeholder="you@example.com"
                required
              />

            </div>

          </div>


          <div class="field">

            <label for="subject">
              Subject
            </label>

            <input
              id="subject"
              type="text"
              placeholder="What can we help you with?"
              required
            />

          </div>


          <div class="field">

            <label for="message">
              Message
            </label>

            <textarea
              id="message"
              rows="6"
              placeholder="Tell us a little more..."
              required
            ></textarea>

          </div>


          <button type="submit">

            <span>
              Send Message
            </span>

            <span class="button-arrow">
              →
            </span>

          </button>


          <p
            id="success-message"
            class="success-message"
          >
            Thank you! Your message has been received.
          </p>

        </form>

      </div>

    </section>


    <!-- =========================
         BOTTOM CTA
    ========================== -->

    <section class="contact-bottom">

      <p class="eyebrow">
        SOMETHING SWEET AWAITS
      </p>

      <h2>
        Explore our menu.
      </h2>

      <p>
        Discover cakes, pastries and freshly prepared
        bakery favorites made for every occasion.
      </p>

      <a href="/menu">
        View Our Menu →
      </a>

    </section>

  </main>

</Layout>


<script>

  const contactForm =
    document.querySelector("#contact-form");

  const successMessage =
    document.querySelector("#success-message");

  contactForm?.addEventListener("submit", (event) => {

    event.preventDefault();

    if (successMessage) {
      successMessage.classList.add("show");
    }

    contactForm.reset();

  });

</script>


<style>

  /* =========================
     BASE
  ========================== */

  .contact-page {
    background: #ffffff;
    color: #0b1f3a;
  }


  .eyebrow {
    margin: 0 0 17px;

    color: #8a6a38;

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 3px;
  }


  /* =========================
     HERO
  ========================== */

  .contact-hero {

    min-height: 450px;

    padding: 80px 8%;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
      linear-gradient(
        135deg,
        #ffffff 0%,
        #f7fbff 55%,
        #e9f1f7 100%
      );

  }


  .hero-inner {
    max-width: 850px;
  }


  .contact-hero h1 {

    margin: 0;

    color: #0b1f3a;

    font-size: clamp(46px, 6vw, 70px);

    line-height: 1.08;

    letter-spacing: -2px;

  }


  .contact-hero h1 span {

    display: block;

    color: #547896;

  }


  .hero-description {

    max-width: 650px;

    margin: 27px auto 0;

    color: #657485;

    font-size: 16px;

    line-height: 1.8;

  }


  /* =========================
     MAIN CONTACT SECTION
  ========================== */

  .contact-section {

    max-width: 1200px;

    margin: 0 auto;

    padding: 100px 30px;

    display: grid;

    grid-template-columns: 0.9fr 1.1fr;

    gap: 100px;

  }


  /* =========================
     DETAILS
  ========================== */

  .contact-details {

    padding-top: 10px;

  }


  .contact-details h2 {

    margin: 0 0 25px;

    color: #0b1f3a;

    font-size: clamp(38px, 4vw, 52px);

    line-height: 1.12;

    letter-spacing: -1px;

  }


  .details-intro {

    max-width: 440px;

    margin: 0 0 45px;

    color: #718090;

    font-size: 14px;

    line-height: 1.8;

  }


  .detail-item {

    display: grid;

    grid-template-columns: 45px 1fr;

    gap: 18px;

    padding: 22px 0;

    border-top: 1px solid #dce3e9;

  }


  .detail-item:last-child {

    border-bottom: 1px solid #dce3e9;

  }


  .detail-number {

    color: #8a6a38;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 1px;

    padding-top: 3px;

  }


  .detail-item h3 {

    margin: 0 0 7px;

    color: #0b1f3a;

    font-size: 16px;

  }


  .detail-item p {

    margin: 0;

    color: #748291;

    font-size: 13px;

    line-height: 1.7;

  }


  /* =========================
     FORM
  ========================== */

  .form-wrapper {

    padding: 45px;

    background: #f6f8fa;

    border: 1px solid #e1e7ec;

  }


  .form-header {

    margin-bottom: 35px;

  }


  .form-header h2 {

    margin: 0 0 10px;

    color: #0b1f3a;

    font-size: 32px;

    letter-spacing: -0.5px;

  }


  .form-header p:last-child {

    margin: 0;

    color: #788695;

    font-size: 13px;

  }


  /* =========================
     FORM FIELDS
  ========================== */

  form {

    display: flex;

    flex-direction: column;

    gap: 23px;

  }


  .form-row {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 18px;

  }


  .field {

    display: flex;

    flex-direction: column;

    gap: 8px;

  }


  label {

    color: #0b1f3a;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.5px;

  }


  input,
  textarea {

    width: 100%;

    box-sizing: border-box;

    padding: 14px 15px;

    border: 1px solid #d5dde4;

    border-radius: 2px;

    background: #ffffff;

    color: #0b1f3a;

    font-family: inherit;

    font-size: 13px;

    outline: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;

  }


  input {

    height: 48px;

  }


  textarea {

    min-height: 130px;

    resize: vertical;

  }


  input::placeholder,
  textarea::placeholder {

    color: #9ba6b0;

  }


  input:focus,
  textarea:focus {

    border-color: #547896;

    box-shadow:
      0 0 0 3px rgba(84, 120, 150, 0.08);

  }


  /* =========================
     BUTTON
  ========================== */

  form button {

    width: 100%;

    height: 52px;

    padding: 0 18px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    border: none;

    border-radius: 2px;

    background: #0b1f3a;

    color: #ffffff;

    cursor: pointer;

    font-family: inherit;

    font-size: 13px;

    font-weight: 700;

    transition:
      background 0.25s ease,
      transform 0.25s ease;

  }


  form button:hover {

    background: #18395d;

    transform: translateY(-2px);

  }


  .button-arrow {

    font-size: 18px;

    transition: transform 0.25s ease;

  }


  form button:hover .button-arrow {

    transform: translateX(5px);

  }


  /* =========================
     SUCCESS
  ========================== */

  .success-message {

    display: none;

    margin: -5px 0 0;

    padding: 12px;

    background: #edf5f0;

    color: #3f6b50;

    font-size: 12px;

    text-align: center;

  }


  .success-message.show {

    display: block;

  }


  /* =========================
     BOTTOM CTA
  ========================== */

  .contact-bottom {

    padding: 100px 25px;

    text-align: center;

    background: #0b1f3a;

  }


  .contact-bottom .eyebrow {

    color: #c9a96e;

  }


  .contact-bottom h2 {

    margin: 0 0 18px;

    color: #ffffff;

    font-size: clamp(38px, 5vw, 55px);

    line-height: 1.1;

  }


  .contact-bottom p:not(.eyebrow) {

    max-width: 540px;

    margin: 0 auto 30px;

    color: #c8d3de;

    font-size: 14px;

    line-height: 1.8;

  }


  .contact-bottom a {

    display: inline-block;

    padding: 15px 28px;

    background: #ffffff;

    color: #0b1f3a;

    text-decoration: none;

    border-radius: 2px;

    font-size: 13px;

    font-weight: 700;

    transition: 0.25s;

  }


  .contact-bottom a:hover {

    background: #eaf2f8;

    transform: translateY(-2px);

  }


  /* =========================
     TABLET
  ========================== */

  @media (max-width: 950px) {

    .contact-section {

      grid-template-columns: 1fr;

      gap: 60px;

      max-width: 750px;

    }

  }


  /* =========================
     MOBILE
  ========================== */

  @media (max-width: 650px) {

    .contact-hero {

      min-height: auto;

      padding: 65px 20px;

    }


    .contact-hero h1 {

      font-size: 42px;

      letter-spacing: -1.2px;

    }


    .hero-description {

      font-size: 14px;

      line-height: 1.75;

    }


    .contact-section {

      padding: 65px 20px;

      gap: 55px;

    }


    .contact-details h2 {

      font-size: 38px;

    }


    .details-intro {

      margin-bottom: 30px;

    }


    .form-wrapper {

      padding: 28px 20px;

    }


    .form-row {

      grid-template-columns: 1fr;

      gap: 23px;

    }


    .form-header h2 {

      font-size: 28px;

    }


    .contact-bottom {

      padding: 70px 20px;

    }

  }


  /* =========================
     SMALL PHONES
  ========================== */

  @media (max-width: 380px) {

    .contact-hero {

      padding: 55px 18px;

    }


    .contact-hero h1 {

      font-size: 36px;

    }


    .contact-section {

      padding: 55px 18px;

    }


    .form-wrapper {

      padding: 25px 17px;

    }

  }

</style>