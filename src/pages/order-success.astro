---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Order Success - Sravs Bakery">

  <main class="success-page">

    <div class="success-card">

      <!-- SUCCESS HEADER -->

      <div class="success-header">

        <div class="success-icon">
          ✓
        </div>

        <p class="subtitle">
          ORDER CONFIRMED
        </p>

        <h1>
          Thank You for Your Order
        </h1>

        <p class="success-message">
          Your order has been placed successfully.
          We appreciate you choosing Sravs Bakery.
        </p>

      </div>


      <!-- ORDER DETAILS -->

      <section class="details-section">

        <div class="section-heading">

          <span class="section-number">
            01
          </span>

          <div>
            <p>YOUR ORDER</p>
            <h2>Order Details</h2>
          </div>

        </div>


        <div id="order-items"></div>


        <div class="total-row">

          <span>
            Total Amount
          </span>

          <strong id="total-amount">
            ₹0
          </strong>

        </div>

      </section>


      <!-- DELIVERY DETAILS -->

      <section class="details-section">

        <div class="section-heading">

          <span class="section-number">
            02
          </span>

          <div>
            <p>DELIVERY</p>
            <h2>Delivery Details</h2>
          </div>

        </div>


        <div class="details-list">

          <div class="detail-row">
            <span>Name</span>
            <strong id="customer-name">-</strong>
          </div>

          <div class="detail-row">
            <span>Phone</span>
            <strong id="customer-phone">-</strong>
          </div>

          <div class="detail-row">
            <span>Email</span>
            <strong id="customer-email">-</strong>
          </div>

          <div class="detail-row">
            <span>Address</span>
            <strong id="customer-address">-</strong>
          </div>

          <div class="detail-row">
            <span>Area</span>
            <strong id="customer-area">-</strong>
          </div>

          <div class="detail-row">
            <span>City</span>
            <strong id="customer-city">-</strong>
          </div>

          <div class="detail-row">
            <span>State</span>
            <strong id="customer-state">-</strong>
          </div>

          <div class="detail-row">
            <span>Pincode</span>
            <strong id="customer-pincode">-</strong>
          </div>

        </div>

      </section>


      <!-- PAYMENT DETAILS -->

      <section class="details-section">

        <div class="section-heading">

          <span class="section-number">
            03
          </span>

          <div>
            <p>PAYMENT</p>
            <h2>Payment Details</h2>
          </div>

        </div>


        <div class="details-list">

          <div class="detail-row">

            <span>
              Payment Method
            </span>

            <strong id="payment-method">
              -
            </strong>

          </div>


          <div
            class="detail-row"
            id="payment-id-row"
          >

            <span>
              Payment ID
            </span>

            <strong id="payment-id">
              -
            </strong>

          </div>


          <div class="detail-row">

            <span>
              Order ID
            </span>

            <strong id="order-id">
              -
            </strong>

          </div>

        </div>


        <!-- STATUS -->

        <div class="status-box">

          <div>

            <span class="status-label">
              PAYMENT STATUS
            </span>

            <p>
              Your payment status
            </p>

          </div>

          <strong id="payment-status">
            -
          </strong>

        </div>

      </section>


      <!-- BUTTON -->

      <a
        href="/menu"
        class="shopping-button"
      >

        <span>
          Continue Shopping
        </span>

        <span class="arrow">
          →
        </span>

      </a>


      <p class="bottom-note">
        Freshly baked with love by Sravs Bakery ♡
      </p>

    </div>

  </main>

</Layout>


<script>

  /* =====================================================
     GET LAST ORDER
  ===================================================== */

  const order =
    JSON.parse(
      localStorage.getItem("lastOrder") || "null"
    );


  /* =====================================================
     ELEMENTS
  ===================================================== */

  const orderItems =
    document.getElementById("order-items");

  const totalAmount =
    document.getElementById("total-amount");

  const customerName =
    document.getElementById("customer-name");

  const customerPhone =
    document.getElementById("customer-phone");

  const customerEmail =
    document.getElementById("customer-email");

  const customerAddress =
    document.getElementById("customer-address");

  const customerArea =
    document.getElementById("customer-area");

  const customerCity =
    document.getElementById("customer-city");

  const customerState =
    document.getElementById("customer-state");

  const customerPincode =
    document.getElementById("customer-pincode");

  const paymentMethod =
    document.getElementById("payment-method");

  const paymentId =
    document.getElementById("payment-id");

  const paymentIdRow =
    document.getElementById("payment-id-row");

  const orderId =
    document.getElementById("order-id");

  const paymentStatus =
    document.getElementById("payment-status");


  /* =====================================================
     NO ORDER
  ===================================================== */

  if (!order) {

    if (orderItems) {

      orderItems.innerHTML = `

        <p class="empty-message">
          No recent order found.
        </p>

      `;

    }

  } else {

    /* ===================================================
       CUSTOMER DETAILS
    =================================================== */

    const customer =
      order.customer || {};


    if (customerName) {

      customerName.textContent =
        customer.name || "-";

    }


    if (customerPhone) {

      customerPhone.textContent =
        customer.phone || "-";

    }


    if (customerEmail) {

      customerEmail.textContent =
        customer.email || "-";

    }


    if (customerAddress) {

      customerAddress.textContent =
        customer.address || "-";

    }


    if (customerArea) {

      customerArea.textContent =
        customer.area || "-";

    }


    if (customerCity) {

      customerCity.textContent =
        customer.city || "-";

    }


    if (customerState) {

      customerState.textContent =
        customer.state || "-";

    }


    if (customerPincode) {

      customerPincode.textContent =
        customer.pincode || "-";

    }


    /* ===================================================
       ORDER ITEMS
    =================================================== */

    const items =
      Array.isArray(order.items)
        ? order.items
        : [];


    items.forEach((item) => {

      const price =
        Number(
          String(item.price || 0)
            .replace(/[^\d.]/g, "")
        ) || 0;


      const quantity =
        Number(item.quantity) || 1;


      const itemTotal =
        price * quantity;


      if (orderItems) {

        orderItems.innerHTML += `

          <div class="order-item">

            <div class="product-info">

              <span class="product-name">
                ${item.name || "Product"}
              </span>

              <span class="product-quantity">
                × ${quantity}
              </span>

            </div>

            <strong>
              ₹${itemTotal.toLocaleString("en-IN")}
            </strong>

          </div>

        `;

      }

    });


    /* ===================================================
       TOTAL
    =================================================== */

    const total =
      Number(order.total) || 0;


    if (totalAmount) {

      totalAmount.textContent =
        "₹" +
        total.toLocaleString("en-IN");

    }


    /* ===================================================
       PAYMENT METHOD
    =================================================== */

    const method =
      order.paymentMethod || "";


    if (paymentMethod) {

      paymentMethod.textContent =
        method || "-";

    }


    /* ===================================================
       PAYMENT ID
    =================================================== */

    if (
      method === "Cash on Delivery"
    ) {

      if (paymentIdRow) {

        paymentIdRow.style.display =
          "none";

      }

    } else {

      if (paymentIdRow) {

        paymentIdRow.style.display =
          "flex";

      }


      if (paymentId) {

        paymentId.textContent =
          order.paymentId || "-";

      }

    }


    /* ===================================================
       ORDER ID
    =================================================== */

    if (orderId) {

      orderId.textContent =
        order.orderId || "-";

    }


    /* ===================================================
       PAYMENT STATUS
    =================================================== */

    const currentStatus =
      order.paymentStatus || "Pending";


    if (paymentStatus) {

      paymentStatus.textContent =
        currentStatus === "Paid"
          ? "PAID ✓"
          : "PENDING";


      paymentStatus.classList.remove(
        "paid",
        "pending"
      );


      if (
        currentStatus === "Paid"
      ) {

        paymentStatus.classList.add(
          "paid"
        );

      } else {

        paymentStatus.classList.add(
          "pending"
        );

      }

    }

  }

</script>


<style>

  /* =====================================================
     PAGE
  ===================================================== */

  .success-page {

    min-height: 100vh;

    padding: 75px 20px 100px;

    background:
      #f9f5f1;

  }


  /* =====================================================
     CARD
  ===================================================== */

  .success-card {

    max-width: 760px;

    margin: 0 auto;

    padding: 55px 55px 45px;

    background: #ffffff;

    border: 1px solid #eee3da;

    box-shadow:
      0 20px 60px
      rgba(60, 40, 25, 0.08);

  }


  /* =====================================================
     SUCCESS HEADER
  ===================================================== */

  .success-header {

    text-align: center;

    padding-bottom: 35px;

    border-bottom:
      1px solid #eee3da;

  }


  .success-icon {

    width: 76px;

    height: 76px;

    margin: 0 auto 22px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #edf5ed;

    border:
      1px solid #d7e7d7;

    color: #568064;

    font-family:
      Georgia,
      serif;

    font-size: 38px;

  }


  .subtitle {

    margin: 0 0 10px;

    color: #a66a45;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 3px;

  }


  .success-header h1 {

    margin: 0;

    color: #2b211c;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 38px;

    font-weight: 500;

    line-height: 1.2;

  }


  .success-message {

    max-width: 500px;

    margin: 14px auto 0;

    color: #756a64;

    font-size: 14px;

    line-height: 1.7;

  }


  /* =====================================================
     SECTION
  ===================================================== */

  .details-section {

    margin-top: 38px;

    padding-top: 5px;

  }


  .section-heading {

    display: flex;

    align-items: center;

    gap: 15px;

    margin-bottom: 20px;

  }


  .section-number {

    width: 38px;

    height: 38px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #f7eee8;

    color: #a66a45;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 1px;

  }


  .section-heading p {

    margin: 0 0 3px;

    color: #a66a45;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 2px;

  }


  .section-heading h2 {

    margin: 0;

    color: #2b211c;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 22px;

    font-weight: 500;

  }


  /* =====================================================
     ORDER ITEMS
  ===================================================== */

  .order-item {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    padding: 14px 0;

    border-bottom:
      1px solid #f0e9e4;

    color: #514740;

    font-size: 14px;

  }


  .product-info {

    display: flex;

    align-items: center;

    gap: 8px;

  }


  .product-name {

    color: #2b211c;

    font-weight: 500;

  }


  .product-quantity {

    color: #9a8d85;

  }


  .order-item strong {

    color: #a66a45;

    font-size: 15px;

  }


  /* =====================================================
     TOTAL
  ===================================================== */

  .total-row {

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 20px 0;

    margin-top: 5px;

    border-top:
      1px solid #ded3ca;

  }


  .total-row span {

    color: #756a64;

    font-size: 14px;

  }


  .total-row strong {

    color: #a66a45;

    font-family:
      Georgia,
      serif;

    font-size: 25px;

  }


  /* =====================================================
     DELIVERY DETAILS
  ===================================================== */

  .details-list {

    border-top:
      1px solid #f0e9e4;

  }


  .detail-row {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 30px;

    padding: 13px 0;

    border-bottom:
      1px solid #f0e9e4;

    font-size: 13px;

  }


  .detail-row span {

    color: #8a7c73;

    flex-shrink: 0;

  }


  .detail-row strong {

    color: #3b302a;

    text-align: right;

    font-weight: 600;

    word-break: break-word;

  }


  /* =====================================================
     PAYMENT STATUS
  ===================================================== */

  .status-box {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-top: 20px;

    padding: 18px 20px;

    background: #faf7f4;

    border:
      1px solid #eee3da;

  }


  .status-label {

    display: block;

    margin-bottom: 4px;

    color: #a66a45;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 2px;

  }


  .status-box p {

    margin: 0;

    color: #8a7c73;

    font-size: 12px;

  }


  #payment-status {

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 1px;

  }


  #payment-status.paid {

    color: #568064;

  }


  #payment-status.pending {

    color: #b47b20;

  }


  /* =====================================================
     BUTTON
  ===================================================== */

  .shopping-button {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 12px;

    margin-top: 42px;

    padding: 16px 24px;

    background: #2b211c;

    color: #ffffff;

    text-decoration: none;

    font-size: 13px;

    font-weight: 600;

    transition: all 0.3s ease;

  }


  .shopping-button:hover {

    background: #a66a45;

    transform:
      translateY(-2px);

  }


  .arrow {

    font-size: 18px;

  }


  /* =====================================================
     BOTTOM NOTE
  ===================================================== */

  .bottom-note {

    margin: 22px 0 0;

    text-align: center;

    color: #a2958d;

    font-family:
      Georgia,
      serif;

    font-size: 12px;

    font-style: italic;

  }


  /* =====================================================
     EMPTY
  ===================================================== */

  .empty-message {

    padding: 20px;

    text-align: center;

    color: #8a7c73;

    background: #faf7f4;

  }


  /* =====================================================
     MOBILE
  ===================================================== */

  @media (max-width: 600px) {

    .success-page {

      padding: 45px 14px 70px;

    }


    .success-card {

      padding: 35px 20px;

    }


    .success-header h1 {

      font-size: 30px;

    }


    .success-message {

      font-size: 13px;

    }


    .details-section {

      margin-top: 32px;

    }


    .section-heading h2 {

      font-size: 20px;

    }


    .detail-row {

      align-items: flex-start;

      flex-direction: column;

      gap: 5px;

    }


    .detail-row strong {

      text-align: left;

      width: 100%;

    }


    .status-box {

      gap: 15px;

    }


    .status-box p {

      font-size: 11px;

    }


    #payment-status {

      font-size: 11px;

    }

  }

</style>