```astro
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Checkout - Sravs Bakery">

  <main class="checkout-page">

    <!-- HERO -->

    <section class="checkout-hero">

      <div class="hero-content">

        <span class="eyebrow">
          YOUR ORDER
        </span>

        <h1>
          Shopping Cart
        </h1>

        <p>
          Take a moment to review your selection
          before completing your order.
        </p>

      </div>

    </section>


    <!-- CART -->

    <section class="cart-section">

      <div id="cart-container"></div>

      <div id="cart-total"></div>

    </section>

  </main>


  <script>

    const cartContainer =
      document.getElementById("cart-container");

    const cartTotal =
      document.getElementById("cart-total");


    /* =========================
       GET CART
    ========================= */

    function getCart() {

      return JSON.parse(
        localStorage.getItem("cart") || "[]"
      );

    }


    /* =========================
       DISPLAY CART
    ========================= */

    function displayCart() {

      const cart = getCart();

      cartContainer.innerHTML = "";


      /* EMPTY CART */

      if (cart.length === 0) {

        cartContainer.innerHTML = `

          <div class="empty-cart">

            <div class="empty-symbol">
              ✦
            </div>

            <span class="empty-eyebrow">
              NOTHING HERE YET
            </span>

            <h2>
              Your cart is empty
            </h2>

            <p>
              Discover something delicious
              from our freshly baked collection.
            </p>

            <a href="/menu">
              Explore Our Menu
            </a>

          </div>

        `;

        cartTotal.innerHTML = "";

        return;

      }


      let total = 0;


      /* CART PRODUCTS */

      cart.forEach((item, index) => {

        const price = Number(
          String(item.price)
            .replace(/[^0-9.]/g, "")
        );

        const quantity =
          Number(item.quantity) || 1;

        const itemTotal =
          price * quantity;

        total += itemTotal;


        cartContainer.innerHTML += `

          <article class="cart-item">

            <div class="product-image">

              <img
                src="${item.image}"
                alt="${item.name}"
              >

            </div>


            <div class="product-details">

              <span class="product-label">
                FRESHLY BAKED
              </span>

              <h2>
                ${item.name}
              </h2>

              <p class="unit-price">
                ₹${price}
              </p>


              <div class="product-bottom">

                <div class="quantity">

                  <button
                    class="quantity-btn"
                    data-index="${index}"
                    data-change="-1"
                    type="button"
                    aria-label="Decrease quantity"
                  >
                    −
                  </button>

                  <span>
                    ${quantity}
                  </span>

                  <button
                    class="quantity-btn"
                    data-index="${index}"
                    data-change="1"
                    type="button"
                    aria-label="Increase quantity"
                  >
                    +
                  </button>

                </div>


                <div class="actions">

                  <button
                    class="remove"
                    data-index="${index}"
                    type="button"
                  >
                    Remove
                  </button>

                  <button
                    class="save"
                    data-index="${index}"
                    type="button"
                  >
                    Save for later
                  </button>

                </div>

              </div>

            </div>


            <div class="item-total">

              <span>
                TOTAL
              </span>

              <strong>
                ₹${itemTotal}
              </strong>

            </div>

          </article>

        `;

      });


      /* =========================
         ORDER SUMMARY
      ========================= */

      cartTotal.innerHTML = `

        <aside class="summary">

          <div class="summary-heading">

            <span>
              ORDER SUMMARY
            </span>

            <h2>
              Your Order
            </h2>

          </div>


          <div class="summary-row">

            <span>
              Subtotal
            </span>

            <strong>
              ₹${total}
            </strong>

          </div>


          <div class="summary-row delivery-row">

            <span>
              Delivery
            </span>

            <span class="free">
              Complimentary
            </span>

          </div>


          <div class="summary-divider"></div>


          <div class="total-row">

            <span>
              Total
            </span>

            <strong>
              ₹${total}
            </strong>

          </div>


          <button
            class="checkout-btn"
            id="payment-btn"
            type="button"
          >

            Proceed to Payment

            <span>
              →
            </span>

          </button>


          <p class="secure-note">
            Secure checkout · Freshly prepared with care
          </p>

        </aside>

      `;


      /* QUANTITY */

      document
        .querySelectorAll(".quantity-btn")
        .forEach((button) => {

          button.addEventListener(
            "click",
            () => {

              const index =
                Number(button.dataset.index);

              const change =
                Number(button.dataset.change);

              changeQuantity(index, change);

            }
          );

        });


      /* REMOVE */

      document
        .querySelectorAll(".remove")
        .forEach((button) => {

          button.addEventListener(
            "click",
            () => {

              const index =
                Number(button.dataset.index);

              removeItem(index);

            }
          );

        });


      /* SAVE */

      document
        .querySelectorAll(".save")
        .forEach((button) => {

          button.addEventListener(
            "click",
            () => {

              const index =
                Number(button.dataset.index);

              saveForLater(index);

            }
          );

        });


      /* PAYMENT */

      const paymentButton =
        document.getElementById("payment-btn");


      if (paymentButton) {

        paymentButton.addEventListener(
          "click",
          proceedToPayment
        );

      }

    }


    /* =========================
       CHANGE QUANTITY
    ========================= */

    function changeQuantity(index, change) {

      const cart = getCart();

      if (!cart[index]) return;


      const currentQuantity =
        Number(cart[index].quantity) || 1;


      cart[index].quantity =
        currentQuantity + change;


      if (cart[index].quantity <= 0) {

        cart.splice(index, 1);

      }


      localStorage.setItem(
        "cart",
        JSON.stringify(cart)
      );


      displayCart();

    }


    /* =========================
       REMOVE
    ========================= */

    function removeItem(index) {

      const cart = getCart();

      if (!cart[index]) return;


      const productName =
        cart[index].name;


      cart.splice(index, 1);


      localStorage.setItem(
        "cart",
        JSON.stringify(cart)
      );


      displayCart();


      alert(
        `${productName} removed from cart.`
      );

    }


    /* =========================
       SAVE FOR LATER
    ========================= */

    function saveForLater(index) {

      const cart = getCart();

      if (!cart[index]) return;


      const item = cart[index];


      let savedItems =
        JSON.parse(
          localStorage.getItem("savedItems") || "[]"
        );


      const alreadySaved =
        savedItems.some(
          saved => saved.name === item.name
        );


      if (!alreadySaved) {

        savedItems.push(item);

      }


      cart.splice(index, 1);


      localStorage.setItem(
        "cart",
        JSON.stringify(cart)
      );


      localStorage.setItem(
        "savedItems",
        JSON.stringify(savedItems)
      );


      displayCart();


      alert(
        `${item.name} saved for later.`
      );

    }


    /* =========================
       PAYMENT
    ========================= */

    function proceedToPayment() {

      const cart = getCart();


      if (cart.length === 0) {

        alert("Your cart is empty!");

        return;

      }


      window.location.href =
        "/payment";

    }


    /* =========================
       INITIAL LOAD
    ========================= */

    displayCart();

  </script>


  <style>

    /* =========================
       PAGE
    ========================= */

    :global(.checkout-page) {

      min-height: 100vh;

      background:
        linear-gradient(
          180deg,
          #faf8f3 0%,
          #ffffff 45%,
          #faf8f3 100%
        );

      padding-bottom: 90px;

      color: #292621;

    }


    /* =========================
       HERO
    ========================= */

    :global(.checkout-hero) {

      padding: 70px 25px 55px;

      text-align: center;

      border-bottom: 1px solid #e7e1d8;

    }


    :global(.hero-content) {

      max-width: 760px;

      margin: auto;

    }


    :global(.eyebrow),
    :global(.product-label),
    :global(.summary-heading span),
    :global(.empty-eyebrow) {

      display: block;

      font-size: 11px;

      letter-spacing: 3px;

      font-weight: 700;

      color: #a47c45;

    }


    :global(.hero-content h1) {

      margin: 13px 0 10px;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 52px;

      font-weight: 500;

      letter-spacing: -1px;

      color: #292621;

    }


    :global(.hero-content p) {

      max-width: 520px;

      margin: auto;

      color: #777066;

      font-size: 15px;

      line-height: 1.8;

    }


    /* =========================
       CART SECTION
    ========================= */

    :global(.cart-section) {

      width: min(1100px, calc(100% - 50px));

      margin: 45px auto 0;

    }


    /* =========================
       CART ITEM
    ========================= */

    :global(.cart-item) {

      display: grid;

      grid-template-columns:
        150px 1fr 130px;

      gap: 28px;

      align-items: center;

      padding: 25px 0;

      border-bottom: 1px solid #e6e0d7;

    }


    :global(.cart-item:first-child) {

      border-top: 1px solid #e6e0d7;

    }


    /* =========================
       IMAGE
    ========================= */

    :global(.product-image) {

      width: 150px;

      height: 150px;

      overflow: hidden;

      background: #f1eee8;

    }


    :global(.product-image img) {

      width: 100%;

      height: 100%;

      object-fit: cover;

      display: block;

      transition: transform .5s ease;

    }


    :global(.cart-item:hover .product-image img) {

      transform: scale(1.05);

    }


    /* =========================
       DETAILS
    ========================= */

    :global(.product-label) {

      margin-bottom: 8px;

      font-size: 9px;

      letter-spacing: 2px;

    }


    :global(.product-details h2) {

      margin: 0 0 7px;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 22px;

      font-weight: 500;

      color: #292621;

    }


    :global(.unit-price) {

      margin: 0;

      color: #756e64;

      font-size: 14px;

    }


    :global(.product-bottom) {

      display: flex;

      align-items: center;

      gap: 28px;

      margin-top: 18px;

    }


    /* =========================
       QUANTITY
    ========================= */

    :global(.quantity) {

      display: flex;

      align-items: center;

      border: 1px solid #d9d2c8;

      height: 36px;

    }


    :global(.quantity-btn) {

      width: 34px;

      height: 34px;

      border: none;

      background: transparent;

      color: #403a33;

      font-size: 17px;

      cursor: pointer;

      transition: background .2s ease;

    }


    :global(.quantity-btn:hover) {

      background: #f1eee8;

    }


    :global(.quantity span) {

      min-width: 32px;

      text-align: center;

      font-size: 13px;

      font-weight: 600;

    }


    /* =========================
       ACTIONS
    ========================= */

    :global(.actions) {

      display: flex;

      gap: 18px;

    }


    :global(.remove),
    :global(.save) {

      border: none;

      background: transparent;

      padding: 0;

      font-size: 12px;

      cursor: pointer;

      color: #756e64;

      transition: color .2s ease;

    }


    :global(.remove:hover) {

      color: #a3473e;

    }


    :global(.save:hover) {

      color: #a47c45;

    }


    /* =========================
       ITEM TOTAL
    ========================= */

    :global(.item-total) {

      text-align: right;

    }


    :global(.item-total span) {

      display: block;

      margin-bottom: 6px;

      font-size: 9px;

      letter-spacing: 2px;

      color: #a0988c;

    }


    :global(.item-total strong) {

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 21px;

      font-weight: 500;

      color: #292621;

    }


    /* =========================
       SUMMARY
    ========================= */

    :global(#cart-total) {

      display: flex;

      justify-content: flex-end;

      margin-top: 45px;

    }


    :global(.summary) {

      width: 400px;

      padding: 30px;

      background: #f5f1e9;

      border: 1px solid #e3dbcf;

    }


    :global(.summary-heading) {

      margin-bottom: 25px;

    }


    :global(.summary-heading h2) {

      margin: 7px 0 0;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 25px;

      font-weight: 500;

    }


    :global(.summary-row) {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: 16px;

      font-size: 14px;

      color: #655e55;

    }


    :global(.summary-row strong) {

      color: #292621;

      font-weight: 600;

    }


    :global(.free) {

      color: #71805d;

      font-size: 12px;

      font-weight: 600;

    }


    :global(.summary-divider) {

      height: 1px;

      background: #dcd3c7;

      margin: 22px 0;

    }


    :global(.total-row) {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: 25px;

    }


    :global(.total-row span) {

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 19px;

    }


    :global(.total-row strong) {

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 27px;

      font-weight: 500;

    }


    /* =========================
       PAYMENT BUTTON
    ========================= */

    :global(.checkout-btn) {

      width: 100%;

      min-height: 52px;

      border: none;

      background: #292621;

      color: #fff;

      padding: 14px 20px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      font-size: 13px;

      letter-spacing: .5px;

      cursor: pointer;

      transition:
        background .25s ease,
        transform .25s ease;

    }


    :global(.checkout-btn span) {

      font-size: 20px;

      transition: transform .25s ease;

    }


    :global(.checkout-btn:hover) {

      background: #a47c45;

    }


    :global(.checkout-btn:hover span) {

      transform: translateX(5px);

    }


    :global(.checkout-btn:active) {

      transform: scale(.99);

    }


    :global(.secure-note) {

      margin: 16px 0 0;

      text-align: center;

      color: #8c847a;

      font-size: 10px;

      letter-spacing: .5px;

    }


    /* =========================
       EMPTY CART
    ========================= */

    :global(.empty-cart) {

      text-align: center;

      padding: 90px 20px;

      border-top: 1px solid #e6e0d7;

      border-bottom: 1px solid #e6e0d7;

    }


    :global(.empty-symbol) {

      width: 60px;

      height: 60px;

      margin: 0 auto 20px;

      border: 1px solid #d8c9b5;

      border-radius: 50%;

      display: flex;

      align-items: center;

      justify-content: center;

      color: #a47c45;

      font-size: 20px;

    }


    :global(.empty-cart h2) {

      margin: 10px 0;

      font-family:
        Georgia,
        "Times New Roman",
        serif;

      font-size: 30px;

      font-weight: 500;

    }


    :global(.empty-cart p) {

      max-width: 420px;

      margin: auto;

      color: #777066;

      font-size: 14px;

      line-height: 1.7;

    }


    :global(.empty-cart a) {

      display: inline-block;

      margin-top: 25px;

      padding: 13px 28px;

      background: #292621;

      color: #fff;

      text-decoration: none;

      font-size: 12px;

      letter-spacing: .5px;

      transition: background .2s ease;

    }


    :global(.empty-cart a:hover) {

      background: #a47c45;

    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 700px) {

      :global(.checkout-hero) {

        padding: 45px 18px 38px;

      }


      :global(.hero-content h1) {

        font-size: 38px;

      }


      :global(.hero-content p) {

        font-size: 13px;

      }


      :global(.cart-section) {

        width: calc(100% - 30px);

        margin-top: 25px;

      }


      :global(.cart-item) {

        grid-template-columns:
          90px 1fr;

        gap: 15px;

        padding: 20px 0;

        position: relative;

      }


      :global(.product-image) {

        width: 90px;

        height: 90px;

      }


      :global(.product-details h2) {

        font-size: 17px;

        padding-right: 55px;

      }


      :global(.product-bottom) {

        display: block;

        margin-top: 13px;

      }


      :global(.quantity) {

        width: fit-content;

      }


      :global(.actions) {

        margin-top: 10px;

        gap: 13px;

      }


      :global(.remove),
      :global(.save) {

        font-size: 10px;

      }


      :global(.item-total) {

        position: absolute;

        right: 0;

        top: 20px;

      }


      :global(.item-total span) {

        display: none;

      }


      :global(.item-total strong) {

        font-size: 16px;

      }


      :global(#cart-total) {

        margin-top: 30px;

      }


      :global(.summary) {

        width: 100%;

        padding: 23px;

      }


      :global(.summary-heading h2) {

        font-size: 22px;

      }


      :global(.total-row strong) {

        font-size: 24px;

      }

    }


    @media (max-width: 380px) {

      :global(.hero-content h1) {

        font-size: 32px;

      }


      :global(.cart-section) {

        width: calc(100% - 22px);

      }


      :global(.product-image) {

        width: 78px;

        height: 78px;

      }


      :global(.cart-item) {

        grid-template-columns:
          78px 1fr;

        gap: 12px;

      }


      :global(.product-details h2) {

        font-size: 15px;

      }

    }

  </style>

</Layout>
```
