---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Checkout">

  <div class="checkout-page">

    <div class="checkout-header">
      <h1>🛒 Shopping Cart</h1>
      <p>Review your items before checkout</p>
    </div>

    <div id="cart-container"></div>

    <div id="cart-total"></div>

  </div>


  <script>

    const cartContainer = document.getElementById("cart-container");
    const cartTotal = document.getElementById("cart-total");


    /* =========================
       GET CART
    ========================= */

    function getCart() {
      return JSON.parse(
        localStorage.getItem("cart") || "[]"
      );
    }


    /* =========================
       DISPLAY CART
    ========================= */

    function displayCart() {

      const cart = getCart();

      cartContainer.innerHTML = "";


      /* EMPTY CART */

      if (cart.length === 0) {

        cartContainer.innerHTML = `

          <div class="empty-cart">

            <div class="empty-icon">
              🛒
            </div>

            <h2>Your cart is empty</h2>

            <p>
              Add some delicious products from our menu.
            </p>

            <a href="/menu">
              Continue Shopping
            </a>

          </div>

        `;

        cartTotal.innerHTML = "";

        return;
      }


      let total = 0;


      /* =========================
         CART PRODUCTS
      ========================= */

      cart.forEach((item, index) => {

        const price = Number(
          String(item.price).replace(/[^0-9.]/g, "")
        );

        const quantity = Number(item.quantity) || 1;

        const itemTotal = price * quantity;

        total += itemTotal;


        cartContainer.innerHTML += `

          <div class="cart-item">

            <!-- PRODUCT IMAGE -->

            <div class="image-box">

              <img
                src="${item.image}"
                alt="${item.name}"
              >

            </div>


            <!-- PRODUCT DETAILS -->

            <div class="details">

              <h2>
                ${item.name}
              </h2>

              <p class="price">
                ₹${price}
              </p>


              <!-- QUANTITY -->

              <div class="quantity">

                <button
                  class="quantity-btn"
                  data-index="${index}"
                  data-change="-1"
                  type="button"
                >
                  −
                </button>

                <span>
                  ${quantity}
                </span>

                <button
                  class="quantity-btn"
                  data-index="${index}"
                  data-change="1"
                  type="button"
                >
                  +
                </button>

              </div>


              <!-- ACTIONS -->

              <div class="actions">

                <button
                  class="remove"
                  data-index="${index}"
                  type="button"
                >
                  Remove
                </button>

                <span class="separator">
                  |
                </span>

                <button
                  class="save"
                  data-index="${index}"
                  type="button"
                >
                  Save for later
                </button>

              </div>

            </div>


            <!-- ITEM TOTAL -->

            <div class="item-total">

              ₹${itemTotal}

            </div>

          </div>

        `;

      });


      /* =========================
         ORDER SUMMARY
      ========================= */

      cartTotal.innerHTML = `

        <div class="summary">

          <div class="subtotal">

            <span>
              Subtotal (${cart.length}
              item${cart.length > 1 ? "s" : ""})
            </span>

            <strong>
              ₹${total}
            </strong>

          </div>


          <div class="delivery">

            <span>
              Delivery
            </span>

            <span class="free">
              FREE
            </span>

          </div>


          <div class="grand-total">

            <span>
              Total
            </span>

            <strong>
              ₹${total}
            </strong>

          </div>


          <button
            class="checkout-btn"
            id="payment-btn"
            type="button"
          >
            Proceed to Payment
          </button>

        </div>

      `;


      /* =========================
         QUANTITY BUTTONS
      ========================= */

      document
        .querySelectorAll(".quantity-btn")
        .forEach((button) => {

          button.addEventListener("click", () => {

            const index = Number(
              button.dataset.index
            );

            const change = Number(
              button.dataset.change
            );

            changeQuantity(index, change);

          });

        });


      /* =========================
         REMOVE BUTTONS
      ========================= */

      document
        .querySelectorAll(".remove")
        .forEach((button) => {

          button.addEventListener("click", () => {

            const index = Number(
              button.dataset.index
            );

            removeItem(index);

          });

        });


      /* =========================
         SAVE BUTTONS
      ========================= */

      document
        .querySelectorAll(".save")
        .forEach((button) => {

          button.addEventListener("click", () => {

            const index = Number(
              button.dataset.index
            );

            saveForLater(index);

          });

        });


      /* =========================
         PAYMENT BUTTON
      ========================= */

      const paymentButton =
        document.getElementById("payment-btn");


      if (paymentButton) {

        paymentButton.addEventListener(
          "click",
          proceedToPayment
        );

      }

    }


    /* =========================
       CHANGE QUANTITY
    ========================= */

    function changeQuantity(index, change) {

      const cart = getCart();


      if (!cart[index]) {
        return;
      }


      const currentQuantity =
        Number(cart[index].quantity) || 1;


      cart[index].quantity =
        currentQuantity + change;


      /* REMOVE IF QUANTITY BECOMES ZERO */

      if (cart[index].quantity <= 0) {

        cart.splice(index, 1);

      }


      localStorage.setItem(
        "cart",
        JSON.stringify(cart)
      );


      displayCart();

    }


    /* =========================
       REMOVE PRODUCT
    ========================= */

    function removeItem(index) {

      const cart = getCart();


      if (!cart[index]) {
        return;
      }


      const productName =
        cart[index].name;


      cart.splice(index, 1);


      localStorage.setItem(
        "cart",
        JSON.stringify(cart)
      );


      displayCart();


      alert(
        `${productName} removed from cart.`
      );

    }


    /* =========================
       SAVE FOR LATER
    ========================= */

    function saveForLater(index) {

      const cart = getCart();


      if (!cart[index]) {
        return;
      }


      const item = cart[index];


      let savedItems = JSON.parse(
        localStorage.getItem("savedItems") || "[]"
      );


      /* CHECK DUPLICATE */

      const alreadySaved =
        savedItems.some(
          saved => saved.name === item.name
        );


      if (!alreadySaved) {

        savedItems.push(item);

      }


      /* REMOVE FROM CART */

      cart.splice(index, 1);


      localStorage.setItem(
        "cart",
        JSON.stringify(cart)
      );


      localStorage.setItem(
        "savedItems",
        JSON.stringify(savedItems)
      );


      displayCart();


      alert(
        `${item.name} saved for later ❤️`
      );

    }


    /* =========================
       PAYMENT
    ========================= */
function proceedToPayment() {

  const cart = getCart();

  if (cart.length === 0) {

    alert("Your cart is empty!");

    return;

  }

  window.location.href = "/payment";

}


    /* =========================
       INITIAL LOAD
    ========================= */

    displayCart();

  </script>



  <style>

    /* =========================
       PAGE
    ========================= */

    :global(.checkout-page) {

      max-width: 1000px;

      margin: 40px auto;

      padding: 0 25px;

      font-family: Arial, sans-serif;

    }


    /* =========================
       HEADER
    ========================= */

    :global(.checkout-header) {

      margin-bottom: 25px;

    }


    :global(.checkout-header h1) {

      font-size: 30px;

      margin: 0;

      color: #222;

    }


    :global(.checkout-header p) {

      margin-top: 7px;

      color: #777;

      font-size: 15px;

    }


    /* =========================
       CART ITEM
    ========================= */

    :global(.cart-item) {

      display: flex;

      align-items: center;

      gap: 20px;

      padding: 18px 5px;

      border-top: 1px solid #e5e5e5;

      min-height: 140px;

    }


    /* =========================
       IMAGE
    ========================= */

    :global(.image-box) {

      width: 120px;

      height: 120px;

      flex-shrink: 0;

      overflow: hidden;

      border-radius: 10px;

      background: #f8f8f8;

      display: flex;

      align-items: center;

      justify-content: center;

    }


    :global(.image-box img) {

      width: 120px;

      height: 120px;

      max-width: 120px;

      max-height: 120px;

      object-fit: cover;

      display: block;

      border-radius: 10px;

    }


    /* =========================
       DETAILS
    ========================= */

    :global(.details) {

      flex: 1;

      min-width: 0;

    }


    :global(.details h2) {

      font-size: 19px;

      font-weight: 600;

      margin: 0 0 7px;

      color: #222;

      line-height: 1.3;

    }


    :global(.price) {

      font-size: 15px;

      font-weight: 500;

      color: #555;

      margin: 0 0 10px;

    }


    /* =========================
       QUANTITY
    ========================= */

    :global(.quantity) {

      display: flex;

      align-items: center;

      gap: 12px;

      margin-top: 5px;

    }


    :global(.quantity-btn) {

      width: 28px;

      height: 28px;

      border: 1px solid #ccc;

      background: white;

      border-radius: 5px;

      font-size: 18px;

      line-height: 1;

      cursor: pointer;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 0;

    }


    :global(.quantity-btn:hover) {

      background: #f5f5f5;

    }


    :global(.quantity-btn:active) {

      transform: scale(0.94);

    }


    :global(.quantity span) {

      min-width: 20px;

      text-align: center;

      font-size: 15px;

      font-weight: 600;

    }


    /* =========================
       ACTIONS
    ========================= */

    :global(.actions) {

      display: flex;

      align-items: center;

      gap: 9px;

      margin-top: 9px;

    }


    :global(.remove),
    :global(.save) {

      border: none;

      background: transparent;

      padding: 0;

      cursor: pointer;

      font-size: 13px;

    }


    :global(.remove) {

      color: #d32f2f;

    }


    :global(.save) {

      color: #1976d2;

    }


    :global(.remove:hover),
    :global(.save:hover) {

      text-decoration: underline;

    }


    :global(.separator) {

      color: #ccc;

    }


    /* =========================
       ITEM TOTAL
    ========================= */

    :global(.item-total) {

      width: 100px;

      flex-shrink: 0;

      text-align: right;

      font-size: 17px;

      font-weight: 700;

      color: #222;

    }


    /* =========================
       SUMMARY
    ========================= */

    :global(#cart-total) {

      border-top: 1px solid #ddd;

      margin-top: 5px;

      padding: 25px 5px;

    }


    :global(.summary) {

      max-width: 380px;

      margin-left: auto;

    }


    :global(.subtotal),
    :global(.delivery),
    :global(.grand-total) {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: 13px;

      font-size: 15px;

    }


    :global(.subtotal strong) {

      font-size: 17px;

    }


    :global(.delivery) {

      color: #555;

    }


    :global(.free) {

      color: #168a45;

      font-weight: 600;

    }


    :global(.grand-total) {

      border-top: 1px solid #ddd;

      padding-top: 16px;

      margin-top: 15px;

      font-size: 19px;

    }


    :global(.grand-total strong) {

      font-size: 23px;

    }


    /* =========================
       PAYMENT BUTTON
    ========================= */

    :global(.checkout-btn) {

      width: 100%;

      margin-top: 15px;

      padding: 13px 20px;

      border: none;

      border-radius: 7px;

      background: #f7c948;

      border: 1px solid #e0ad20;

      font-size: 16px;

      font-weight: 600;

      cursor: pointer;

    }


    :global(.checkout-btn:hover) {

      background: #f2b900;

    }


    :global(.checkout-btn:active) {

      transform: scale(0.99);

    }


    /* =========================
       EMPTY CART
    ========================= */

    :global(.empty-cart) {

      text-align: center;

      padding: 70px 20px;

      border-top: 1px solid #ddd;

    }


    :global(.empty-icon) {

      font-size: 55px;

      margin-bottom: 15px;

    }


    :global(.empty-cart h2) {

      margin: 0 0 8px;

    }


    :global(.empty-cart p) {

      color: #777;

    }


    :global(.empty-cart a) {

      display: inline-block;

      margin-top: 15px;

      padding: 11px 22px;

      background: #f7c948;

      color: #222;

      text-decoration: none;

      border-radius: 8px;

      font-weight: 600;

    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 600px) {

      :global(.checkout-page) {

        margin: 20px auto;

        padding: 0 12px;

      }


      :global(.checkout-header h1) {

        font-size: 25px;

      }


      :global(.cart-item) {

        gap: 12px;

        padding: 15px 0;

        align-items: center;

      }


      :global(.image-box) {

        width: 80px;

        height: 80px;

      }


      :global(.image-box img) {

        width: 80px;

        height: 80px;

      }


      :global(.details h2) {

        font-size: 14px;

      }


      :global(.price) {

        font-size: 14px;

      }


      :global(.quantity) {

        gap: 8px;

      }


      :global(.quantity-btn) {

        width: 26px;

        height: 26px;

        font-size: 16px;

      }


      :global(.item-total) {

        width: auto;

        font-size: 14px;

      }


      /* SAVE FOR LATER MOBILE LO KUDA VISIBLE */

      :global(.save),
      :global(.separator) {

        display: inline-block;

      }


      :global(.actions) {

        gap: 6px;

      }


      :global(.remove),
      :global(.save) {

        font-size: 11px;

      }


      :global(.summary) {

        max-width: 100%;

      }

    }

  </style>

</Layout>