---
import Layout from "../layouts/Layout.astro";
import products from "../data/Products.js";

const featuredProducts = products.slice(0, 4);
---

<Layout title="Sravs Bakery">

  <!-- =========================
       HERO
  ========================== -->

  <section class="hero">

    <div class="hero-content">

      <p class="eyebrow">WELCOME TO SRAVS BAKERY</p>

      <h1>
        Crafted with care.<br />
        <span>Baked for moments.</span>
      </h1>

      <p class="hero-description">
        Discover beautifully crafted cakes, pastries and freshly baked
        favorites made with quality ingredients and a passion for
        unforgettable flavor.
      </p>

      <div class="hero-buttons">
        <a href="/menu" class="primary-button">
          Explore Our Menu
        </a>

        <a href="/about" class="secondary-button">
          Our Story
        </a>
      </div>

      <div class="hero-trust">

        <div>
          <strong>Fresh</strong>
          <span>Every Day</span>
        </div>

        <div class="trust-line"></div>

        <div>
          <strong>Premium</strong>
          <span>Ingredients</span>
        </div>

        <div class="trust-line"></div>

        <div>
          <strong>Made</strong>
          <span>With Care</span>
        </div>

      </div>

    </div>


    <div class="hero-image-wrapper">

      <div class="hero-image-background"></div>

      <img
        src="/products/icon7.jpg"
        alt="Freshly baked treats from Sravs Bakery"
        class="hero-image"
      />

      <div class="floating-card">

        <div class="floating-icon">✦</div>

        <div>
          <strong>Freshly Baked</strong>
          <span>Made with love & care</span>
        </div>

      </div>

    </div>

  </section>


  <!-- =========================
       INTRODUCTION
  ========================== -->

  <section class="intro-section">

    <div class="section-label">
      THE SRAVS EXPERIENCE
    </div>

    <h2>
      More than a bakery.<br />
      <span>A little sweeter part of your day.</span>
    </h2>

    <p>
      At Sravs Bakery, we believe that great food has the power to turn
      ordinary moments into memorable ones. From beautifully decorated
      cakes to comforting pastries and freshly baked treats, every item
      is prepared with attention to quality, freshness and flavor.
    </p>

  </section>


  <!-- =========================
       SIGNATURE COLLECTION
  ========================== -->

  <section class="collection-section">

    <div class="section-heading">

      <div>
        <p class="eyebrow">OUR FAVORITES</p>

        <h2>
          Signature Collection
        </h2>
      </div>

      <a href="/menu" class="view-link">
        View Full Menu →
      </a>

    </div>


    <div class="product-grid">

      {
        featuredProducts.map((product) => (

          <a
            href="/menu"
            class="product-card"
          >

            <div class="product-image-wrapper">

              <img
                src={product.image}
                alt={product.name}
              />

              <span class="product-tag">
                FAVORITE
              </span>

            </div>

            <div class="product-info">

              <h3>
                {product.name}
              </h3>

              <p>
                Freshly prepared with quality ingredients
                and delicious flavor.
              </p>

              <div class="product-bottom">

                <strong>
                  ${Number(product.price).toFixed(2)}
                </strong>

                <span>
                  Explore →
                </span>

              </div>

            </div>

          </a>

        ))
      }

    </div>

  </section>


  <!-- =========================
       WHY SRAVS
  ========================== -->

  <section class="why-section">

    <div class="why-intro">

      <p class="eyebrow">
        WHY CHOOSE US
      </p>

      <h2>
        Made with intention.<br />
        <span>Served with warmth.</span>
      </h2>

      <p>
        We focus on the little details that make a bakery experience
        special — from the ingredients we choose to the care that goes
        into every creation.
      </p>

    </div>


    <div class="features-grid">

      <div class="feature-card">

        <div class="feature-number">
          01
        </div>

        <h3>
          Freshly Baked
        </h3>

        <p>
          Our treats are prepared fresh so every bite feels as good
          as the first.
        </p>

      </div>


      <div class="feature-card">

        <div class="feature-number">
          02
        </div>

        <h3>
          Quality Ingredients
        </h3>

        <p>
          We believe better ingredients create better flavor and a
          better experience.
        </p>

      </div>


      <div class="feature-card">

        <div class="feature-number">
          03
        </div>

        <h3>
          Crafted With Care
        </h3>

        <p>
          Every cake, pastry and treat receives attention to detail
          from preparation to presentation.
        </p>

      </div>


      <div class="feature-card">

        <div class="feature-number">
          04
        </div>

        <h3>
          Made For Moments
        </h3>

        <p>
          From everyday cravings to special celebrations, we are here
          to make every occasion sweeter.
        </p>

      </div>

    </div>

  </section>


  <!-- =========================
       STORY SECTION
  ========================== -->

  <section class="story-section">

    <div class="story-image">

      <img
        src="/products/icon8.jpg"
        alt="Sravs Bakery"
      />

    </div>


    <div class="story-content">

      <p class="eyebrow">
        OUR STORY
      </p>

      <h2>
        Where simple ingredients
        become something special.
      </h2>

      <p>
        Sravs Bakery was created with a simple idea — to make delicious,
        beautiful and comforting baked treats that people can enjoy
        during both everyday moments and important celebrations.
      </p>

      <p>
        We combine familiar flavors with thoughtful preparation to
        create treats that feel homemade, fresh and memorable.
      </p>

      <a href="/about" class="text-button">
        Discover Our Story →
      </a>

    </div>

  </section>


  <!-- =========================
       CATEGORIES
  ========================== -->

  <section class="categories-section">

    <div class="center-heading">

      <p class="eyebrow">
        EXPLORE
      </p>

      <h2>
        Something for every craving
      </h2>

      <p>
        From celebrations to everyday indulgence,
        find something made just for you.
      </p>

    </div>


    <div class="category-grid">

      <a href="/menu" class="category-card">

        <div class="category-image">
          <img
            src="/products/icon2.jpg"
            alt="Celebration Cakes"
          />
        </div>

        <div class="category-content">
          <span>01</span>
          <h3>Celebration Cakes</h3>
          <p>Make every occasion memorable.</p>
          <strong>Explore →</strong>
        </div>

      </a>


      <a href="/menu" class="category-card">

        <div class="category-image">
          <img
            src="/products/icon3.jpg"
            alt="Pastries and Desserts"
          />
        </div>

        <div class="category-content">
          <span>02</span>
          <h3>Pastries & Desserts</h3>
          <p>Sweet little moments of joy.</p>
          <strong>Explore →</strong>
        </div>

      </a>


      <a href="/menu" class="category-card">

        <div class="category-image">
          <img
            src="/products/icon4.jpg"
            alt="Fresh Bakes"
          />
        </div>

        <div class="category-content">
          <span>03</span>
          <h3>Fresh Bakes</h3>
          <p>Freshly prepared favorites.</p>
          <strong>Explore →</strong>
        </div>

      </a>


      <a href="/menu" class="category-card">

        <div class="category-image">
          <img
            src="/products/icon5.jpg"
            alt="Cookies and Treats"
          />c:\Users\P.Sravanti\Desktop\Bakery-Website\images\icon2.jpeg
        </div>

        <div class="category-content">
          <span>04</span>
          <h3>Cookies & Treats</h3>
          <p>Perfect for every little craving.</p>
          <strong>Explore →</strong>
        </div>

      </a>

    </div>

  </section>


  <!-- =========================
       CTA
  ========================== -->

  <section class="cta-section">

    <div class="cta-content">

      <p class="eyebrow">
        MADE FOR YOUR MOMENTS
      </p>

      <h2>
        Make your next celebration<br />
        a little sweeter.
      </h2>

      <p>
        Explore our collection of freshly prepared cakes,
        pastries and bakery favorites.
      </p>

      <a href="/menu" class="cta-button">
        Shop Our Collection
      </a>

    </div>

  </section>


  <!-- =========================
       CONTACT PREVIEW
  ========================== -->

  <section class="contact-preview">

    <div>

      <p class="eyebrow">
        HAVE A QUESTION?
      </p>

      <h2>
        We'd love to hear from you.
      </h2>

    </div>

    <a href="/contact" class="secondary-button">
      Contact Us →
    </a>

  </section>

</Layout>
<style>
/* =====================================================
   GLOBAL
===================================================== */

* {
  box-sizing: border-box;
}

section {
  width: 100%;
}

.eyebrow {
  margin: 0 0 12px;
  color: #8a6a38;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2.5px;
}

h1,
h2,
h3,
p {
  overflow-wrap: break-word;
}


/* =====================================================
   HERO
===================================================== */

.hero {
  min-height: auto;
  padding: 70px 7%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 55px;

  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f7fbff 55%,
      #eaf2f8 100%
    );

  overflow: hidden;
}

.hero-content {
  max-width: 620px;
}

.hero h1 {
  margin: 0;
  color: #0b1f3a;
  font-size: clamp(45px, 5vw, 70px);
  line-height: 1.05;
  letter-spacing: -2px;
}

.hero h1 span {
  color: #345c82;
}

.hero-description {
  max-width: 560px;
  margin: 24px 0;
  color: #536273;
  font-size: 16px;
  line-height: 1.75;
}

.hero-buttons {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 32px;
}

.primary-button,
.secondary-button,
.cta-button {
  display: inline-block;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
  transition: 0.25s ease;
}

.primary-button {
  padding: 13px 22px;
  background: #0b1f3a;
  color: white;
  border-radius: 4px;
}

.primary-button:hover {
  background: #18395d;
  transform: translateY(-2px);
}

.secondary-button {
  padding: 12px 21px;
  color: #0b1f3a;
  border: 1px solid #b9c6d2;
  background: white;
  border-radius: 4px;
}

.secondary-button:hover {
  border-color: #0b1f3a;
}

.hero-trust {
  display: flex;
  align-items: center;
  gap: 18px;
}

.hero-trust div:not(.trust-line) {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.hero-trust strong {
  color: #0b1f3a;
  font-size: 12px;
}

.hero-trust span {
  color: #718090;
  font-size: 10px;
}

.trust-line {
  width: 1px;
  height: 28px;
  background: #c8d3dd;
}


/* =====================================================
   HERO IMAGE
===================================================== */

.hero-image-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 520px;
}

.hero-image-background {
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: #dceaf4;
}

.hero-image {
  position: relative;
  z-index: 2;
  width: min(100%, 440px);
  height: 500px;
  object-fit: cover;
  border-radius: 230px 230px 12px 12px;
  box-shadow: 0 25px 60px rgba(11, 31, 58, 0.16);
}

.floating-card {
  position: absolute;
  z-index: 3;
  bottom: 20px;
  left: 2%;

  display: flex;
  align-items: center;
  gap: 10px;

  background: white;
  padding: 12px 16px;

  box-shadow: 0 12px 30px rgba(11, 31, 58, 0.12);
  border-radius: 5px;
}

.floating-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf2f8;
  color: #8a6a38;
  border-radius: 50%;
}

.floating-card strong,
.floating-card span {
  display: block;
}

.floating-card strong {
  color: #0b1f3a;
  font-size: 12px;
}

.floating-card span {
  color: #7a8794;
  font-size: 10px;
  margin-top: 2px;
}


/* =====================================================
   INTRO
===================================================== */

.intro-section {
  padding: 80px 15%;
  text-align: center;
  background: white;
}

.intro-section h2,
.why-intro h2,
.center-heading h2 {
  margin: 0 0 20px;
  color: #0b1f3a;
  font-size: clamp(32px, 4vw, 48px);
  line-height: 1.12;
  letter-spacing: -1px;
}

.intro-section h2 span,
.why-intro h2 span {
  color: #547896;
}

.intro-section > p:last-child {
  max-width: 700px;
  margin: auto;
  color: #637181;
  font-size: 15px;
  line-height: 1.8;
}


/* =====================================================
   OUR FAVORITES
===================================================== */

.collection-section {
  padding: 75px 7%;
  background: #f7f9fb;
}

.section-heading {
  max-width: 1150px;
  margin: 0 auto 30px;

  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 25px;
}

.section-heading h2 {
  margin: 0;
  color: #0b1f3a;
  font-size: 40px;
}

.view-link {
  color: #0b1f3a;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  border-bottom: 1px solid #0b1f3a;
  padding-bottom: 4px;
}


/* =====================================================
   PRODUCT GRID
===================================================== */

.product-grid {
  max-width: 1150px;
  margin: auto;

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.product-card {
  background: white;
  text-decoration: none;
  color: inherit;
  border: 1px solid #e7ebef;
  transition: 0.3s ease;
}

.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 35px rgba(11, 31, 58, 0.1);
}

.product-image-wrapper {
  position: relative;
  height: 240px;
  overflow: hidden;
}

.product-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: 0.4s ease;
}

.product-card:hover img {
  transform: scale(1.05);
}

.product-tag {
  position: absolute;
  top: 12px;
  left: 12px;

  background: #0b1f3a;
  color: white;

  padding: 5px 8px;
  font-size: 8px;
  letter-spacing: 1.3px;
  font-weight: 700;
}

.product-info {
  padding: 18px;
}

.product-info h3 {
  margin: 0 0 8px;
  color: #0b1f3a;
  font-size: 17px;
}

.product-info p {
  min-height: 38px;
  margin: 0 0 15px;
  color: #788594;
  font-size: 12px;
  line-height: 1.55;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;

  border-top: 1px solid #edf0f3;
  padding-top: 13px;
}

.product-bottom strong {
  color: #0b1f3a;
  font-size: 14px;
}

.product-bottom span {
  color: #547896;
  font-size: 11px;
  font-weight: 700;
}


/* =====================================================
   WHY CHOOSE US
===================================================== */

.why-section {
  max-width: 1200px;
  margin: auto;

  padding: 80px 7%;

  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 70px;
  align-items: start;

  background: white;
}

.why-intro {
  position: sticky;
  top: 90px;
}

.why-intro > p:last-child {
  max-width: 400px;
  color: #687685;
  font-size: 14px;
  line-height: 1.75;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  border: 1px solid #dfe6ec;
}

.feature-card {
  min-height: 190px;
  padding: 28px;

  background: white;

  border-right: 1px solid #dfe6ec;
  border-bottom: 1px solid #dfe6ec;
}

.feature-card:nth-child(2n) {
  border-right: none;
}

.feature-card:nth-child(3),
.feature-card:nth-child(4) {
  border-bottom: none;
}

.feature-number {
  margin-bottom: 20px;
  color: #8a6a38;
  font-size: 11px;
  font-weight: 700;
}

.feature-card h3 {
  margin: 0 0 10px;
  color: #0b1f3a;
  font-size: 18px;
}

.feature-card p {
  margin: 0;
  color: #748190;
  font-size: 13px;
  line-height: 1.65;
}


/* =====================================================
   STORY
===================================================== */

.story-section {
  max-width: 1200px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 1fr;

  background: #eaf2f8;
}

.story-image {
  overflow: hidden;
}

.story-image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 500px;
  object-fit: cover;
}

.story-content {
  padding: 65px 8%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.story-content h2 {
  margin: 0 0 20px;
  color: #0b1f3a;
  font-size: clamp(32px, 4vw, 48px);
  line-height: 1.12;
}

.story-content p {
  max-width: 500px;
  color: #536273;
  font-size: 14px;
  line-height: 1.75;
}

.text-button {
  margin-top: 15px;
  color: #0b1f3a;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
}


/* =====================================================
   EXPLORE / CATEGORIES
===================================================== */

.categories-section {
  padding: 80px 7%;
  background: white;
}

.center-heading {
  max-width: 600px;
  margin: 0 auto 35px;
  text-align: center;
}

.center-heading > p:last-child {
  color: #718090;
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
}

.category-grid {
  max-width: 1150px;
  margin: auto;

  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.category-card {
  text-decoration: none;
  border: 1px solid #e3e8ed;
  background: white;
  transition: 0.3s ease;
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(11, 31, 58, 0.09);
}

.category-image {
  height: 210px;
  overflow: hidden;
}

.category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: 0.4s ease;
}

.category-card:hover img {
  transform: scale(1.05);
}

.category-content {
  padding: 20px;
}

.category-content span {
  color: #8a6a38;
  font-size: 10px;
  font-weight: 700;
}

.category-content h3 {
  margin: 10px 0 7px;
  color: #0b1f3a;
  font-size: 18px;
}

.category-content p {
  margin: 0 0 14px;
  color: #7a8794;
  font-size: 12px;
}

.category-content strong {
  color: #547896;
  font-size: 11px;
}


/* =====================================================
   CTA
===================================================== */

.cta-section {
  padding: 85px 7%;
  background: #0b1f3a;
  text-align: center;
}

.cta-content {
  max-width: 700px;
  margin: auto;
}

.cta-section .eyebrow {
  color: #c9a96e;
}

.cta-section h2 {
  margin: 0 0 18px;
  color: white;
  font-size: clamp(34px, 5vw, 55px);
  line-height: 1.12;
}

.cta-section p {
  color: #c7d2dd;
  line-height: 1.7;
  margin-bottom: 28px;
}

.cta-button {
  padding: 14px 25px;
  background: white;
  color: #0b1f3a;
  border-radius: 4px;
}


/* =====================================================
   CONTACT
===================================================== */

.contact-preview {
  padding: 55px 7%;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;

  background: #f7f9fb;
}

.contact-preview h2 {
  margin: 0;
  color: #0b1f3a;
  font-size: 30px;
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1050px) {

  .hero {
    padding: 60px 5%;
    gap: 35px;
  }

  .product-grid,
  .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .why-section {
    gap: 40px;
  }
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 800px) {

  /* HERO */

  .hero {
    grid-template-columns: 1fr;
    padding: 45px 18px 35px;
    gap: 25px;
    text-align: center;
  }

  .hero-content {
    max-width: 100%;
  }

  .hero h1 {
    font-size: 42px;
    letter-spacing: -1.3px;
  }

  .hero-description {
    margin: 18px auto;
    font-size: 14px;
    line-height: 1.7;
  }

  .hero-buttons {
    justify-content: center;
    margin-bottom: 25px;
  }

  .hero-trust {
    justify-content: center;
    gap: 9px;
  }

  .hero-trust strong {
    font-size: 10px;
  }

  .hero-trust span {
    font-size: 8px;
  }

  .hero-image-wrapper {
    min-height: 390px;
  }

  .hero-image {
    width: 82%;
    height: 370px;
  }

  .hero-image-background {
    width: 290px;
    height: 290px;
  }

  .floating-card {
    left: 2%;
    bottom: 5px;
    padding: 10px 12px;
  }


  /* INTRO */

  .intro-section {
    padding: 60px 20px;
  }

  .intro-section h2,
  .why-intro h2,
  .center-heading h2 {
    font-size: 32px;
  }

  .intro-section > p:last-child {
    font-size: 13px;
    line-height: 1.7;
  }


  /* FAVORITES */

  .collection-section {
    padding: 55px 14px;
  }

  .section-heading {
    margin-bottom: 25px;
    padding: 0 5px;
  }

